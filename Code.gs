function _invLoadInvoice_(invoiceId) {
  const inv = supabaseSelect_('invoices', {
    filters: { id: 'eq.' + invoiceId },
    limit: 1
  })[0];

  if (!inv) throw new Error('Invoice not found');

  const lines = supabaseSelect_('invoice_lines', {
