      salesRepPhotoDataUrl: profile ? (profile.photoDataUrl || '') : '',
      clientName: row.client_name || row.client_code || 'UNASSIGNED',
      value: _salesCommandNumber_(row.event_value),
      headline: row.headline || ''
    };
  });
  const overdueOrders = overdueRows.map(function(row) {
    return {
      soNumber: row.so_number || '',
      lineNo: row.line_no == null ? '' : String(row.line_no),
      salesRep: row.sales_rep || 'UNASSIGNED',
      clientName: row.client_name || '',
      productName: row.product_name || '',
      dueDate: row.due_date || '',
      overdueDays: _salesCommandNumber_(row.overdue_days),
      openValue: _salesCommandNumber_(row.open_order_value),
      billingGapQty: _salesCommandNumber_(row.operational_open_qty),
      lastActivityAt: row.last_activity_at || ''
    };
  });
  const flowOrder = [
    { key: 'SALES_APPROVAL', label: 'Sales Approval' },
    { key: 'ARTWORK', label: 'Artwork' },
    { key: 'WO_PENDING', label: 'Work Order' },
    { key: 'PRODUCTION_OR_PACKING', label: 'Production / Packing' },
    { key: 'DISPATCH', label: 'Dispatch' },
    { key: 'BILLING', label: 'Billing' },
    { key: 'COMPLETED', label: 'Completed' }
  ];
  const flowMap = {};
  const flowDivisionMap = {};
  flowOrder.forEach(function(stage) {
    flowMap[stage.key] = { key: stage.key, label: stage.label, lineCount: 0, orderQty: 0 };
  });
  function ensureFlowDivision(name) {
    const key = _salesCommandDivisionLabel_(name);
    if (!flowDivisionMap[key]) {
      const stages = {};
      flowOrder.forEach(function(stage) {
        stages[stage.key] = { key: stage.key, label: stage.label, lineCount: 0, orderQty: 0, openValue: 0 };
      });
      flowDivisionMap[key] = {
        division: key,
        totalLines: 0,
        openQty: 0,
        openValue: 0,
        stages: stages
      };
    }
    return flowDivisionMap[key];
  }
  const openFlowMap = {};
  (flowOpenRows || []).forEach(function(row) {
    const idKey = String(row.so_line_id || '').trim();
    const compositeKey = String(row.so_number || '').trim() + '||' + String(row.line_no == null ? '' : row.line_no).trim();
    const mapped = {
      orderQty: _salesCommandNumber_(row.order_qty),
      operationalOpenQty: _salesCommandNumber_(row.operational_open_qty),
      dispatchedQty: _salesCommandNumber_(row.dispatched_qty),
      billedQty: _salesCommandNumber_(row.billed_qty),
      openOrderValue: _salesCommandNumber_(row.open_order_value),
      division: _salesCommandDivisionLabel_(row.division)
    };
    if (idKey) openFlowMap[idKey] = mapped;
    if (compositeKey !== '||') openFlowMap[compositeKey] = mapped;
  });
  flowRows.forEach(function(row) {
    const idKey = String(row.so_line_id || '').trim();
    const compositeKey = String(row.so_number || '').trim() + '||' + String(row.line_no == null ? '' : row.line_no).trim();
    const openLine = openFlowMap[idKey] || openFlowMap[compositeKey] || null;
    if (!openLine || openLine.operationalOpenQty <= 0) return;
    const state = _reportsLifecycleState_(Object.assign({}, row, {
      order_qty: openLine.orderQty,
      dispatched_qty: openLine.dispatchedQty,
      billed_qty: openLine.billedQty
    }));
    if (!flowMap[state]) return;
    flowMap[state].lineCount += 1;
    flowMap[state].orderQty += openLine.operationalOpenQty;
    const divisionFlow = ensureFlowDivision(openLine.division);
    divisionFlow.totalLines += 1;
    divisionFlow.openQty += openLine.operationalOpenQty;
    divisionFlow.openValue += openLine.openOrderValue;
    divisionFlow.stages[state].lineCount += 1;
    divisionFlow.stages[state].orderQty += openLine.operationalOpenQty;
    divisionFlow.stages[state].openValue += openLine.openOrderValue;
  });
  const maxFlowLines = flowOrder.reduce(function(max, stage) {
    return Math.max(max, _salesCommandNumber_(flowMap[stage.key].lineCount));
  }, 0);
  const orderFlow = flowOrder.map(function(stage) {
    const row = flowMap[stage.key];
    row.isBottleneck = maxFlowLines > 0 && row.lineCount === maxFlowLines;
    return row;
  });
  const orderFlowDivisions = Object.keys(flowDivisionMap).map(function(key) {
    const row = flowDivisionMap[key];
    const stages = flowOrder.map(function(stage) {
      return row.stages[stage.key];
    });
    const bottleneck = stages.slice().sort(function(a, b) {
      return _salesCommandNumber_(b.lineCount) - _salesCommandNumber_(a.lineCount) ||
        _salesCommandNumber_(b.orderQty) - _salesCommandNumber_(a.orderQty);
    })[0] || { key: '', label: '', lineCount: 0, orderQty: 0, openValue: 0 };
    return {
      division: row.division,
      totalLines: row.totalLines,
      openQty: row.openQty,
      openValue: row.openValue,
      bottleneckStage: bottleneck.label,
      bottleneckKey: bottleneck.key,
      bottleneckLines: bottleneck.lineCount,
      bottleneckQty: bottleneck.orderQty,
      bottleneckValue: bottleneck.openValue,
      stages: stages
    };
  }).sort(function(a, b) {
    return _salesCommandNumber_(b.totalLines) - _salesCommandNumber_(a.totalLines) ||
      _salesCommandNumber_(b.openValue) - _salesCommandNumber_(a.openValue) ||
      a.division.localeCompare(b.division);
  });
  const orderFlowMeta = {
    scope: 'Open actionable order lines till date',
    lineCount: (flowOpenRows || []).length,
    orderQty: (flowOpenRows || []).reduce(function(sum, row) {
      return sum + _salesCommandNumber_(row.operational_open_qty);
    }, 0),
    note: 'Excludes manual billing, cancelled, closed, short-closed and fully billed lines.'
  };

  const topRep = reps.slice().sort(function(a, b) {
    return b.orderValueMtd - a.orderValueMtd;
  })[0] || null;
  const topClient = dashboardClients.slice().sort(function(a, b) {
    return b.orderValueMtd - a.orderValueMtd;
  })[0] || null;
  const benchmarkTopClients = clientAnalytics.historicalTop;
  const celebrations = _salesCommandCelebrations_(reps, dashboardClients);
  const result = {
    ok: true,
    generatedAt: new Date().toISOString(),
    periodLabel: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'MMMM yyyy'),
    boardDateLabel: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd MMM yyyy'),
    periods: {
      today: _salesCommandPeriodTotals_(reps, 'Today'),
      wtd: _salesCommandPeriodTotals_(reps, 'Wtd'),
      mtd: _salesCommandPeriodTotals_(reps, 'Mtd')
    },
    totals: totals,
    leaders: {
      topSalesRep: topRep,
      topClient: topClient
    },
    reps: reps,
    clients: dashboardClients,
    topClients: benchmarkTopClients.length ? benchmarkTopClients : dashboardClients.slice(0, 20),
    clientAnalytics: clientAnalytics,
    currentTopClients: dashboardClients.slice(0, 20),
    divisions: divisions,
    purchaseRatio: purchaseRatio,
    branding: {
      companyLogo: brandingAssets && brandingAssets.companyLogo ? brandingAssets.companyLogo : null
    },
    celebrations: celebrations,
    orderFlow: orderFlow,
    orderFlowDivisions: orderFlowDivisions,
    orderFlowMeta: orderFlowMeta,
    overdueOrders: overdueOrders,
    activities: activities,
    insights: _salesCommandBuildInsights_(reps, dashboardClients, totals)
  };
  result.snapshotId = _cacheKeyHash_('SALES_SNAPSHOT', JSON.stringify({
    totals: result.totals,
    reps: result.reps,
    clients: result.clients,
    activity: result.activities.slice(0, 10)
  }));
  _putCachedJson_(cacheKey, result, 10);
  return result;
}

this.salesCommandGetDashboard = salesCommandGetDashboard;

// ===== DEDICATED PLANNING MODULE =====
function _planningCompositeKey_(soNumber, lineNo) {
  return String(soNumber || '').trim() + '||' + String(lineNo == null ? '' : lineNo).trim();
}

function _planningClosureFilters_(params) {
  const p = params || {};
  const out = {
    fromDate: String(p.fromDate || '').trim(),
    toDate: String(p.toDate || '').trim(),
    q: String(p.q || '').trim().toLowerCase(),
    status: String(p.status || '').trim().toLowerCase(),
    division: String(p.division || '').trim()
  };
  if (!out.fromDate && !out.toDate) return out;
  if (out.fromDate && !out.toDate) out.toDate = _reportsTodayDateKey_();
  else if (!out.fromDate && out.toDate) out.fromDate = _reportsShiftDateKey_(out.toDate, -1);
  return out;
}

function _planningClosureEditUser_(token) {
  return _requireModuleAccess_(token, 'PLANNING', 'can_edit');
}

function _planningLineMetaByPlanningRows_(planningRows) {
  const rows = Array.isArray(planningRows) ? planningRows : [];
  if (!rows.length) return {};
  const soNumbers = [...new Set(rows.map(function(row) {
    return String(row.soNumber || '').trim();
  }).filter(Boolean))];
  if (!soNumbers.length) return {};

  const soHeaders = _supabaseSelectByKeyInBatches_(
    'sales_orders',
    'id,so_number',
    'so_number',
    soNumbers,
    null,
    40
  ) || [];
  const soIdToNo = {};
  const soIds = [];
  soHeaders.forEach(function(row) {
    const id = String(row.id || '').trim();
    const soNo = String(row.so_number || '').trim();
    if (!id || !soNo) return;
    soIdToNo[id] = soNo;
    soIds.push(id);
  });
  if (!soIds.length) return {};

  const lineRows = _supabaseSelectByKeyInBatches_(
    'sales_order_lines',
    'id,so_id,line_no,status,closed_at,closed_by,status_updated_at',
    'so_id',
    soIds,
    null,
    40
  ) || [];
  const out = {};
  lineRows.forEach(function(row) {
    const soNo = soIdToNo[String(row.so_id || '').trim()] || '';
    const lineNo = String(row.line_no || '').trim();
    if (!soNo || !lineNo) return;
    out[_planningCompositeKey_(soNo, lineNo)] = row;
  });
  return out;
}

function _planningDisplayClosureStatus_(row) {
  const closedBy = String(row.closedBy || '').trim().toUpperCase();
  const rawStatus = String(row.rawLineStatus || '').toUpperCase();
  if (row.autoClosedByDispatch) return 'CLOSED';
  if (rawStatus === 'SHORT_CLOSED') return 'SHORT_CLOSED';
  if (closedBy.indexOf('SHORT CLOSE') !== -1 || closedBy.indexOf('SHORT_CLOSE') !== -1) return 'SHORT_CLOSED';
  if (rawStatus === 'PARTIAL_DISPATCHED') return 'PARTIAL_DISPATCHED';
  if (rawStatus === 'CLOSED' || rawStatus === 'CANCELLED') return 'CLOSED';
  return 'OPEN';
}

function _planningClosureReason_(row) {
  if (row.autoClosedByDispatch) return 'Fully billed';
  if (String(row.closureStatus || '').toUpperCase() === 'SHORT_CLOSED') return row.closedBy || 'Manual short close';
  if (String(row.closureStatus || '').toUpperCase() === 'CLOSED') return row.closedBy || 'Closed';
  if (String(row.closureStatus || '').toUpperCase() === 'PARTIAL_DISPATCHED') {
    return 'Marked for partial dispatch';
  }
  return 'Billed but not fully closed';
}

function _planningLifecycleColumnsMissing_(err) {
  const msg = String((err && err.message) || err || '');
  return ['status', 'closed_at', 'closed_by', 'status_updated_at'].some(function(key) {
    return msg.indexOf('sales_order_lines.' + key) !== -1 ||
      msg.indexOf('column "' + key + '" of relation "sales_order_lines" does not exist') !== -1 ||
      msg.indexOf("Could not find the '" + key + "' column of 'sales_order_lines'") !== -1;
  });
}

function _planningAutoCloseFullyDispatchedLines_(rows) {
  const ids = [...new Set((rows || []).filter(function(row) {
    return row.autoClosedByDispatch === true &&
      row.soLineId &&
      String(row.rawLineStatus || '').toUpperCase() !== 'CLOSED';
  }).map(function(row) {
    return String(row.soLineId || '').trim();
  }).filter(Boolean))];
  if (!ids.length) return;

  const stamp = new Date().toISOString();
  const payload = {
    status: 'CLOSED',
    closed_at: stamp,
    closed_by: 'System - fully billed',
    status_updated_at: stamp
  };

  _supabaseChunkValuesByFilterLength_(ids, 1200, 40).forEach(function(chunk) {
    try {
      supabaseUpdateMinimal_('sales_order_lines', { id: _supabaseInFilter_(chunk) }, payload);
    } catch (err) {
      if (_planningLifecycleColumnsMissing_(err)) {
        throw new Error('Run sales_order_line_status_schema.sql before using the billed closure planning module.');
      }
      throw err;
    }
  });
}

function _planningBilledClosureViewSelect_() {
  return [
    'so_line_id',
    'so_number',
