      lifecycleStatus: item.item_lifecycle_status || (item.active === false ? 'INACTIVE' : 'ACTIVE'),
      itemMasterNotes: item.item_master_notes || '',
      lengthMm: item.length_mm == null ? '' : Number(item.length_mm),
