function supabaseInsert_(table, payload) {
  return _supabaseFetch_(
    `/rest/v1/${table}`,
    'post',
    payload
  );
}

function supabaseBulkInsert_(table, rows) {
  if (!Array.isArray(rows) || !rows.length) return [];
  return _supabaseFetch_(
    `/rest/v1/${table}`,
    'post',
    rows
  );
}

function supabaseUpsert_(table, payload, options) {
  let path = `/rest/v1/${table}`;
  const headers = {
    'Prefer': 'return=representation,resolution=merge-duplicates'
  };

  if (options && options.onConflict) {
    path += `?on_conflict=${encodeURIComponent(options.onConflict)}`;
  }

  return _supabaseFetch_(
    path,
    'post',
    payload,
    null,
    headers
  );
}


function supabaseRpc_(fn, params) {
  return _supabaseFetch_(
    `/rest/v1/rpc/${fn}`,
    'post',
    params
  );
}

function supabaseUpdate_(table, filters, data) {
  const params = {};
  Object.keys(filters).forEach(k => {
    params[k] = filters[k];
  });

  return _supabaseFetch_(
    `/rest/v1/${table}`,
    'patch',
    data,
    params
  );
}

