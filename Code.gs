  }).filter(Boolean))];
  const fastSelectedMap = _billingTrySelectedDatasetRowMapV4_(selectedLines, headerMode);
  if (fastSelectedMap && selectedIds.every(function(id) { return !!fastSelectedMap[id]; })) {
    (existingLines || []).forEach(function(row) {
