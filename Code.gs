const MODULES = [
    'SALES_ORDER_ENTRY',
    'SALES_ORDER_APPROVAL',
    'ARTWORK',
    'MASTERS',
    'PURCHASE',
  'PLATES',
  'MATERIAL_INDENT',
  'ITEMMASTER',
  'WOW',
  'INVENTORY',
  'PACKING',
  'DISPATCH',
  'PRODUCTION',
  'BILLING',
  'PLANNING',
  'REPORTS',
  'COSTING',
  'NPD',
  'CHECKLIST',
