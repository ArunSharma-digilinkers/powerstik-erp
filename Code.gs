      value: Number(r.value || 0),
      location: r.location || '',
      reason: r.remarks || '',
      reversed: reversalMap[String(r.id || '')]?.reversed === true,
      reversalDate: reversalMap[String(r.id || '')]?.reversalDate || ''
    }))
  };
}

function _invRateRound6_(value) {
  return Number(Number(value || 0).toFixed(6));
}

function _invLedgerValueForRate_(ledger, rate) {
  return _invRateRound6_(Number(ledger?.qty_in || 0) * Number(rate || 0) - Number(ledger?.qty_out || 0) * Number(rate || 0));
}

function _invSelectLedgerForRateCorrection_(ledgerId) {
  const id = String(ledgerId || '').trim();
  if (!id) throw new Error('Source ledger id is required');
  const row = (supabaseSelect_('inv_ledger', {
    select: 'id,item_id,ref_type,ref_no,qty_in,qty_out,rate,value,batch_no,location,department,remarks,created_at',
    filters: { id: 'eq.' + id },
    limit: 1
  }) || [])[0];
  if (!row) throw new Error('Source ledger not found');
  return row;
}

function _invSelectItemForRateCorrection_(itemId) {
  const id = String(itemId || '').trim();
  if (!id) return null;
  return (supabaseSelect_('inv_items', {
    select: 'id,item_code,item_name,category,department,uom',
    filters: { id: 'eq.' + id },
    limit: 1
  }) || [])[0] || null;
}

function _invFindLotForRateCorrection_(ledger) {
  const batchNo = String(ledger?.batch_no || '').trim();
  if (!batchNo) throw new Error('Source ledger does not have a batch number. Correct legacy entries after creating/mapping the batch.');
  const filters = {
    item_id: 'eq.' + ledger.item_id,
    batch_no: 'eq.' + batchNo
  };
  const rows = supabaseSelect_('inv_lots', {
    select: 'id,item_id,item_code,batch_no,source_type,source_ref,location,receipt_date,qty_received,qty_available,rate,department,remarks,created_at',
    filters: filters,
    order: 'created_at.asc',
    limit: 20
  }) || [];
  if (!rows.length) throw new Error('Batch lot not found for source ledger');

  const ledgerLocation = String(ledger.location || '').trim().toUpperCase();
  const sameLocation = rows.find(function(row) {
    return String(row.location || '').trim().toUpperCase() === ledgerLocation;
  });
  return sameLocation || rows[0];
}

function _invAssertRateCorrectionAuditTable_() {
  try {
    supabaseSelect_('inv_rate_corrections', {
      select: 'id',
      limit: 1
    });
  } catch (err) {
    if (_supabaseRelationMissing_(err, 'inv_rate_corrections')) {
      throw new Error('Run inventory_rate_correction_schema.sql in Supabase before applying rate corrections.');
    }
    throw err;
  }
}

function _invLotAllocationsForRateCorrection_(lotId) {
  const id = String(lotId || '').trim();
  if (!id) return [];
  return _supabaseSelectAll_('inv_lot_allocations', {
    select: 'id,ledger_id,lot_id,batch_no,item_id,qty,rate,txn_type,created_at',
    filters: { lot_id: 'eq.' + id },
    order: 'created_at.asc'
  }, 1000, 50000) || [];
}

function _invAffectedLedgerIdsFromAllocations_(allocations) {
  return [...new Set((allocations || []).map(function(row) {
    return String(row.ledger_id || '').trim();
  }).filter(Boolean))];
}

function _invRecalculateAllocatedLedgerValues_(ledgerIds) {
  const ids = _invAffectedLedgerIdsFromAllocations_((ledgerIds || []).map(function(id) {
    return { ledger_id: id };
  }));
  const out = [];
  if (!ids.length) return out;

  ids.forEach(function(ledgerId) {
    const ledger = (supabaseSelect_('inv_ledger', {
      select: 'id,item_id,ref_type,ref_no,qty_in,qty_out,rate,value,batch_no,location,department',
      filters: { id: 'eq.' + ledgerId },
      limit: 1
    }) || [])[0];
    if (!ledger) return;

    const allocations = supabaseSelect_('inv_lot_allocations', {
      select: 'qty,rate',
      filters: { ledger_id: 'eq.' + ledgerId },
      limit: 5000
    }) || [];
    const totalQty = allocations.reduce(function(sum, row) {
      return sum + Number(row.qty || 0);
    }, 0);
    if (!(totalQty > 0)) return;

    const totalValue = allocations.reduce(function(sum, row) {
      return sum + Number(row.qty || 0) * Number(row.rate || 0);
    }, 0);
    const newRate = _invRateRound6_(totalValue / totalQty);
    const oldRate = Number(ledger.rate || 0);
    const oldValue = Number(ledger.value || 0);
    const newValue = _invLedgerValueForRate_(ledger, newRate);

    supabaseUpdateMinimal_('inv_ledger', { id: 'eq.' + ledgerId }, {
      rate: newRate,
      value: newValue
    });

    out.push({
      ledgerId: ledgerId,
      refType: ledger.ref_type || '',
      refNo: ledger.ref_no || '',
      qtyIn: Number(ledger.qty_in || 0),
      qtyOut: Number(ledger.qty_out || 0),
      oldRate: oldRate,
      newRate: newRate,
      oldValue: oldValue,
      newValue: newValue,
      valueDelta: _invRateRound6_(newValue - oldValue)
    });
  });

  return out;
}

function _invTryUpdateLinkedPOReceiptRate_(sourceLedger, item, newRate) {
  if (String(sourceLedger?.ref_type || '').trim().toUpperCase() !== 'PO-RECEIPT') return null;
  const match = invFindMatchingPOReceiptRecord_(sourceLedger, item?.item_code || '', null);
  if (!match || !match.row || !match.row.id) return null;
  supabaseUpdateMinimal_('purchase_po_receipts', { id: 'eq.' + String(match.row.id || '').trim() }, {
    rate: Number(newRate || 0),
    updated_at: _purchaseNowIso_()
  });
  return {
    receiptId: String(match.row.id || '').trim(),
    poNo: String(match.row.poNo || sourceLedger.ref_no || '').trim()
  };
}

function _invBuildRateCorrectionPreview_(payload) {
  const p = payload || {};
  const newRate = Number(p.newRate);
  if (!Number.isFinite(newRate) || newRate < 0) throw new Error('New rate must be a valid non-negative number');

  const sourceLedger = _invSelectLedgerForRateCorrection_(p.sourceLedgerId || p.ledgerId);
  if (!(Number(sourceLedger.qty_in || 0) > 0)) {
    throw new Error('Only receipt/gain source entries can be rate-corrected. Loss/issue entries are recalculated from their consumed lots.');
  }

  const item = _invSelectItemForRateCorrection_(sourceLedger.item_id);
  const lot = _invFindLotForRateCorrection_(sourceLedger);
  const allocations = _invLotAllocationsForRateCorrection_(lot.id);
  const affectedLedgerIds = _invAffectedLedgerIdsFromAllocations_(allocations);
  const oldRate = Number(lot.rate || sourceLedger.rate || 0);
  const qtyReceived = Number(lot.qty_received || sourceLedger.qty_in || 0);
  const qtyAvailable = Number(lot.qty_available || 0);
  const qtyIssued = allocations.reduce(function(sum, row) {
    return sum + Number(row.qty || 0);
  }, 0);
  const rateDelta = _invRateRound6_(newRate - oldRate);

  return {
    ok: true,
    sourceLedgerId: sourceLedger.id,
    sourceRefType: sourceLedger.ref_type || '',
    sourceRefNo: sourceLedger.ref_no || '',
    itemId: sourceLedger.item_id,
    itemCode: item?.item_code || lot.item_code || '',
    itemName: item?.item_name || '',
    lotId: lot.id,
    batchNo: lot.batch_no || '',
    location: lot.location || sourceLedger.location || '',
    department: lot.department || sourceLedger.department || item?.department || '',
    oldRate: oldRate,
    newRate: newRate,
    rateDelta: rateDelta,
    qtyReceived: qtyReceived,
    qtyAvailable: qtyAvailable,
    qtyIssued: qtyIssued,
    sourceValueOld: Number(sourceLedger.value || 0),
    sourceValueNew: _invLedgerValueForRate_(sourceLedger, newRate),
    stockValueDelta: _invRateRound6_(qtyAvailable * rateDelta),
    issuedValueDelta: _invRateRound6_(qtyIssued * rateDelta),
    totalValueDelta: _invRateRound6_(qtyReceived * rateDelta),
    affectedLedgerIds: affectedLedgerIds,
    affectedLedgerCount: affectedLedgerIds.length
  };
}

function invPreviewRateCorrection(payload, token) {
  _requireAdmin_(token);
  return _invBuildRateCorrectionPreview_(payload || {});
}

function invApplyRateCorrection(payload, token) {
  const admin = _requireAdmin_(token);
  _invAssertRateCorrectionAuditTable_();

  const p = payload || {};
  const reason = String(p.reason || '').trim();
  if (!reason) throw new Error('Correction reason is mandatory');

  const preview = _invBuildRateCorrectionPreview_(p);
  const sourceLedger = _invSelectLedgerForRateCorrection_(preview.sourceLedgerId);
  const item = _invSelectItemForRateCorrection_(sourceLedger.item_id);
  const newRate = Number(preview.newRate || 0);
  const oldRate = Number(preview.oldRate || 0);
  const sourceValueNew = _invLedgerValueForRate_(sourceLedger, newRate);
  const stamp = new Date().toISOString();

  supabaseUpdateMinimal_('inv_ledger', { id: 'eq.' + sourceLedger.id }, {
    rate: newRate,
    value: sourceValueNew
  });

  supabaseUpdateMinimal_('inv_lots', { id: 'eq.' + preview.lotId }, {
    rate: newRate
  });

  const allocations = _invLotAllocationsForRateCorrection_(preview.lotId);
  if (allocations.length) {
    supabaseUpdateMinimal_('inv_lot_allocations', { lot_id: 'eq.' + preview.lotId }, {
      rate: newRate
    });
  }

  const affectedLedgers = _invRecalculateAllocatedLedgerValues_(preview.affectedLedgerIds || []);
  const linkedPOReceipt = _invTryUpdateLinkedPOReceiptRate_(sourceLedger, item, newRate);

  supabaseInsertMinimal_('inv_rate_corrections', {
    id: Utilities.getUuid(),
    source_ledger_id: sourceLedger.id,
    lot_id: preview.lotId,
    item_id: sourceLedger.item_id,
    item_code: preview.itemCode || '',
    batch_no: preview.batchNo || '',
    source_type: sourceLedger.ref_type || '',
    source_ref: sourceLedger.ref_no || '',
    old_rate: oldRate,
    new_rate: newRate,
    qty_received: Number(preview.qtyReceived || 0),
    qty_available: Number(preview.qtyAvailable || 0),
    qty_issued: Number(preview.qtyIssued || 0),
    source_value_old: Number(preview.sourceValueOld || 0),
    source_value_new: sourceValueNew,
    stock_value_delta: Number(preview.stockValueDelta || 0),
    issue_value_delta: Number(preview.issuedValueDelta || 0),
    affected_issue_count: affectedLedgers.length,
    affected_ledger_ids: affectedLedgers.map(function(row) { return row.ledgerId; }),
    reason: reason,
    corrected_by: String(admin.displayName || admin.userId || admin.email || '').trim(),
    corrected_at: stamp,
    created_at: stamp
  });

  refreshStockMV_(true);
  PropertiesService.getScriptProperties().setProperty('INV_STOCK_SNAPSHOT_VERSION', String(Date.now()));
  PropertiesService.getScriptProperties().setProperty('PURCHASE_CACHE_VERSION', String(Date.now()));

  return {
    ok: true,
    preview: preview,
    affectedLedgers: affectedLedgers,
    linkedPOReceipt: linkedPOReceipt
  };
}

function _invNormalizeStockItemCode_(value) {
  return String(value || '').trim().toUpperCase();
}

function _invStockSnapshotItemRows_(opts) {
  const q = String(opts && opts.q || '').trim().toLowerCase();
  return (_supabaseSelectAll_('inv_items', {
    select: 'id,item_code,item_name,category,department,uom,active,stock_managed,is_consumable,lead_time_days,moq_qty',
    order: 'item_name.asc'
  }, 1000, 1000000) || []).filter(function(item) {
    const code = _invNormalizeStockItemCode_(item.item_code);
    if (!code) return false;
    if (!q) return true;
    const hay = [
      item.item_code,
      item.item_name,
      item.category,
      item.department,
      item.uom
    ].join(' ').toLowerCase();
    return hay.indexOf(q) !== -1;
  });
}

function _invReconcileStockRows_(rows, opts) {
  const out = Array.isArray(rows) ? rows.slice() : [];
  const allocationMap = _invStockAllocationTotalsMap_(opts || {});
  const locationFilter = String(opts && opts.location || '').trim();
  const defaultLocation = locationFilter || DEFAULT_LOCATION || 'MAIN';
  const itemRows = _invStockSnapshotItemRows_(opts || {});
  const itemMetaByCode = {};
  itemRows.forEach(function(item) {
    const code = _invNormalizeStockItemCode_(item.item_code);
    if (code && !itemMetaByCode[code]) itemMetaByCode[code] = item;
  });
  const existing = {};
  out.forEach(function(row, idx) {
    const code = _invNormalizeStockItemCode_(row.itemCode || row.itemcode || row.item_code);
    if (!code) return;
    const loc = String(row.location || defaultLocation).trim().toUpperCase() || 'MAIN';
    const meta = itemMetaByCode[code] || {};
    const qty = Number(row.qty || 0);
    const allocation = allocationMap['ID|' + String(row.itemId || row.item_id || meta.id || '') + '|' + loc] ||
      allocationMap['CODE|' + code + '|' + loc] || { allocatedQty: 0, allocationCount: 0 };
    const allocatedQty = Math.max(0, Number(allocation.allocatedQty || 0));
    const freeStockQty = Math.max(0, qty - allocatedQty);
    const overallocatedQty = Math.max(0, allocatedQty - qty);
    const dailyConsumption = Number(row.avgDailyConsumption || row.avg_daily_consumption || 0);
    const manualLeadRaw = meta.lead_time_days;
    const manualLead = manualLeadRaw === null || typeof manualLeadRaw === 'undefined' || manualLeadRaw === ''
      ? null
      : Number(manualLeadRaw);
    const baseLead = manualLead !== null && Number.isFinite(manualLead) && manualLead > 0
      ? manualLead
      : Number(row.avgLeadTimeDays || row.avg_lead_time_days || 0);
    const integerUom = _invIsIntegerUom_(meta.uom || row.uom);
    const rawMsl = baseLead > 0 && dailyConsumption > 0
      ? (baseLead * dailyConsumption * 1.2)
      : Number(row.minimumStockLevel || row.minimum_stock_level || 0);
    const msl = integerUom
      ? _invReplenishmentQtyForUom_(rawMsl, meta.uom || row.uom, 0)
      : _invReplenishmentRound_(rawMsl, 2);
    out[idx] = Object.assign({}, row, {
      itemCode: row.itemCode || row.itemcode || row.item_code || meta.item_code || '',
      itemName: row.itemName || row.itemname || row.item_name || meta.item_name || '',
      category: row.category || meta.category || '',
      department: row.department || meta.department || '',
      uom: row.uom || meta.uom || '',
      itemId: row.itemId || row.item_id || meta.id || '',
      isActive: meta.active === false ? false : true,
      stockManaged: meta.stock_managed === false ? false : true,
      isConsumable: meta.is_consumable === true,
      manualLeadTimeDays: meta.lead_time_days === null || typeof meta.lead_time_days === 'undefined' ? '' : Number(meta.lead_time_days),
      moqQty: meta.moq_qty === null || typeof meta.moq_qty === 'undefined' ? '' : Number(meta.moq_qty),
      location: row.location || defaultLocation,
      qty: qty,
      physicalStockQty: qty,
      allocatedQty: allocatedQty,
      freeStockQty: freeStockQty,
      overallocatedQty: overallocatedQty,
      allocationCount: Number(allocation.allocationCount || 0),
      allocatedWorkOrders: allocation.workOrders || '',
      allocationStatus: overallocatedQty > 0 ? 'OVER_ALLOCATED' :
        (allocatedQty <= 0 ? 'FREE' : (freeStockQty <= 0 ? 'FULLY_ALLOCATED' : 'PARTIALLY_ALLOCATED')),
      avgRate: Number(row.avgRate || row.avgrate || row.avg_rate || 0),
      value: Number(row.value || 0),
      avgLeadTimeDays: Number(baseLead || 0),
      avgDailyConsumption: dailyConsumption,
      safetyFactor: Number(row.safetyFactor || row.safety_factor || 1.2),
      minimumStockLevel: msl,
      mslStatus: freeStockQty < msl ? 'BELOW_MSL' : 'OK',
      mslGap: Number((freeStockQty - msl).toFixed(2))
    });
    existing[locationFilter ? (code + '|' + loc) : code] = true;
  });

  itemRows.forEach(function(item) {
    const code = _invNormalizeStockItemCode_(item.item_code);
    if (!code) return;
    const key = locationFilter ? (code + '|' + defaultLocation.toUpperCase()) : code;
    if (existing[key]) return;
    const zeroLocation = defaultLocation.toUpperCase();
    const allocation = allocationMap['ID|' + String(item.id || '') + '|' + zeroLocation] ||
      allocationMap['CODE|' + code + '|' + zeroLocation] || { allocatedQty: 0, allocationCount: 0 };
    const allocatedQty = Math.max(0, Number(allocation.allocatedQty || 0));
    out.push({
      itemCode: item.item_code || '',
      itemName: item.item_name || '',
      category: item.category || '',
      department: item.department || '',
      uom: item.uom || '',
      itemId: item.id || '',
      isActive: item.active === false ? false : true,
      stockManaged: item.stock_managed === false ? false : true,
      isConsumable: item.is_consumable === true,
      manualLeadTimeDays: item.lead_time_days === null || typeof item.lead_time_days === 'undefined' ? '' : Number(item.lead_time_days),
      moqQty: item.moq_qty === null || typeof item.moq_qty === 'undefined' ? '' : Number(item.moq_qty),
      location: defaultLocation,
      qty: 0,
      physicalStockQty: 0,
      allocatedQty: allocatedQty,
      freeStockQty: 0,
      overallocatedQty: allocatedQty,
      allocationCount: Number(allocation.allocationCount || 0),
      allocatedWorkOrders: allocation.workOrders || '',
      allocationStatus: allocatedQty > 0 ? 'OVER_ALLOCATED' : 'FREE',
      avgRate: 0,
      value: 0,
      ageingDays: null,
      movementClass: item.active === false ? 'INACTIVE' : 'UNKNOWN',
      lastMovementAt: '',
      oldestReceiptAt: '',
      nextBatchNo: '',
      batchCount: 0,
      avgLeadTimeDays: 0,
      avgDailyConsumption: 0,
      safetyFactor: 1.2,
      minimumStockLevel: 0,
      mslStatus: 'OK',
      mslGap: 0
    });
    existing[key] = true;
  });

  const sortedRows = out.sort(function(a, b) {
    return String(a.itemName || a.itemCode || '').localeCompare(String(b.itemName || b.itemCode || '')) ||
      String(a.location || '').localeCompare(String(b.location || ''));
  });
  return _invAddStockGstValues_(sortedRows);
}

function _invAddStockGstValues_(rows) {
  const result = Array.isArray(rows) ? rows : [];
  const itemIds = [...new Set(result.map(function(row) {
    return String(row.itemId || row.item_id || '').trim();
  }).filter(Boolean))];
  const itemCodes = [...new Set(result.map(function(row) {
    return _invNormalizeStockItemCode_(row.itemCode || row.item_code || row.itemcode);
  }).filter(Boolean))];
  const fallbackGstByCode = {};

  if (itemCodes.length) {
    try {
      const purchaseMasterRows = _supabaseSelectByKeyInBatches_(
        'v_purchase_rate_master_setup_v2', 'item_code,tax_pct', 'item_code', itemCodes, null, 40
      ) || [];
      purchaseMasterRows.forEach(function(item) {
        const code = _invNormalizeStockItemCode_(item.item_code);
        const taxPct = Number(item.tax_pct || 0);
        if (code && taxPct > 0) fallbackGstByCode[code] = taxPct;
      });
    } catch (err) {
      Logger.log('Inventory GST purchase-rate fallback unavailable: ' + String(err && err.message || err || ''));
    }
    try {
      const poRows = _supabaseSelectByKeyInBatches_(
        'purchase_order_lines', 'item_code,tax_pct,master_tax_pct_snapshot,created_at', 'item_code', itemCodes,
        'created_at.desc', 30
      ) || [];
      poRows.forEach(function(line) {
        const code = _invNormalizeStockItemCode_(line.item_code);
        const taxPct = Number(line.tax_pct || line.master_tax_pct_snapshot || 0);
        if (code && !fallbackGstByCode[code] && taxPct > 0) fallbackGstByCode[code] = taxPct;
      });
    } catch (err) {
      Logger.log('Inventory GST PO-line fallback unavailable: ' + String(err && err.message || err || ''));
    }
    try {
      const salesMasterRows = _supabaseSelectByKeyInBatches_(
        'items', 'item_code,gst_pct', 'item_code', itemCodes, null, 40
      ) || [];
      salesMasterRows.forEach(function(item) {
        const code = _invNormalizeStockItemCode_(item.item_code);
        const taxPct = Number(item.gst_pct || 0);
        if (code && !fallbackGstByCode[code] && taxPct > 0) fallbackGstByCode[code] = taxPct;
      });
    } catch (err) {
      Logger.log('Inventory GST sales-item fallback unavailable: ' + String(err && err.message || err || ''));
    }
  }

  const lotValueByKey = {};
  if (itemIds.length) {
    try {
      const lots = _supabaseSelectByKeyInBatches_(
        'inv_lots', 'id,item_id,location,qty_available,rate', 'item_id', itemIds,
        null, 24
      ).filter(function(lot) { return Number(lot.qty_available || 0) > 0; });
      const lotIds = lots.map(function(lot) { return String(lot.id || '').trim(); }).filter(Boolean);
      const taxByLotId = {};
      if (lotIds.length) {
        const receipts = _supabaseSelectByKeyInBatches_(
          'purchase_po_receipts', 'lot_id,tax_pct,reversed_at', 'lot_id', lotIds,
          null, 24
        ).filter(function(receipt) { return !receipt.reversed_at; });
        receipts.forEach(function(receipt) {
          const lotId = String(receipt.lot_id || '').trim();
          const taxPct = Number(receipt.tax_pct || 0);
          if (lotId && taxPct > 0 && taxByLotId[lotId] == null) taxByLotId[lotId] = taxPct;
        });
      }

      const codeByItemId = {};
      result.forEach(function(row) {
        const id = String(row.itemId || row.item_id || '').trim();
        const code = _invNormalizeStockItemCode_(row.itemCode || row.item_code || row.itemcode);
        if (id && code) codeByItemId[id] = code;
      });
      lots.forEach(function(lot) {
        const itemId = String(lot.item_id || '').trim();
        const location = String(lot.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
        const key = itemId + '|' + location;
        const basicValue = Number(lot.qty_available || 0) * Number(lot.rate || 0);
        const lotId = String(lot.id || '').trim();
        const receiptTaxPct = taxByLotId[lotId];
        const gstPct = receiptTaxPct == null
          ? Number(fallbackGstByCode[codeByItemId[itemId] || ''] || 0)
          : Number(receiptTaxPct || 0);
        if (!lotValueByKey[key]) lotValueByKey[key] = { basicValue: 0, gstValue: 0, receiptTaxValue: 0 };
        lotValueByKey[key].basicValue += basicValue;
        lotValueByKey[key].gstValue += basicValue * gstPct / 100;
        if (receiptTaxPct != null) lotValueByKey[key].receiptTaxValue += basicValue;
      });
    } catch (err) {
      Logger.log('Inventory lot GST valuation unavailable; using item-master GST fallback: ' + String(err && err.message || err || ''));
    }
  }

  return result.map(function(row) {
    const itemId = String(row.itemId || row.item_id || '').trim();
    const location = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
    const code = _invNormalizeStockItemCode_(row.itemCode || row.item_code || row.itemcode);
    const basicValue = Number(row.value || 0);
    const lotValue = lotValueByKey[itemId + '|' + location] || { basicValue: 0, gstValue: 0, receiptTaxValue: 0 };
    const fallbackGstPct = Number(fallbackGstByCode[code] || 0);
    const lotBasicValue = Math.max(0, Number(lotValue.basicValue || 0));
    const coveredBasicValue = Math.min(Math.max(0, basicValue), lotBasicValue);
    const lotEffectiveGstPct = lotBasicValue > 0 ? (Number(lotValue.gstValue || 0) / lotBasicValue) * 100 : 0;
    const uncoveredBasicValue = Math.max(0, basicValue - coveredBasicValue);
    const gstValue = (coveredBasicValue * lotEffectiveGstPct / 100) + (uncoveredBasicValue * fallbackGstPct / 100);
    const gstPct = basicValue > 0 ? (gstValue / basicValue) * 100 : fallbackGstPct;
    return Object.assign({}, row, {
      basicValue: Number(basicValue.toFixed(2)),
      gstPct: Number(gstPct.toFixed(2)),
      gstValue: Number(gstValue.toFixed(2)),
      gstInclusiveValue: Number((basicValue + gstValue).toFixed(2)),
      gstValueSource: Number(lotValue.receiptTaxValue || 0) > 0 ? 'RECEIPT_LOT' : (fallbackGstPct > 0 ? 'ITEM_MASTER' : 'NO_GST')
    });
  });
}

function _invSearchMatchesStockRow_(row, q) {
  const needle = String(q || '').trim().toLowerCase();
  if (!needle) return true;
  return [
    row.item_code,
    row.itemCode,
    row.item_name,
    row.itemName,
    row.category,
    row.department,
    row.uom,
    row.location
  ].join(' ').toLowerCase().indexOf(needle) !== -1;
}

function _invSelectStockMVRows_() {
  const common = {
    order: 'item_name.asc,item_code.asc,location.asc'
  };
  try {
    return _supabaseSelectAll_('inv_stock_mv', Object.assign({}, common, {
      select: 'item_id,item_code,item_name,category,department,uom,location,qty,avg_rate,value,last_movement_at'
    }), 1000, 1000000) || [];
  } catch (err) {
    const msg = String(err && err.message || err || '').toLowerCase();
    if (msg.indexOf('avg_rate') === -1 && msg.indexOf('item_id') === -1 && msg.indexOf('uom') === -1) {
      throw err;
    }
    const rows = _supabaseSelectAll_('inv_stock_mv', Object.assign({}, common, {
      select: 'item_code,item_name,category,department,location,qty,avgrate,value'
    }), 1000, 1000000) || [];
    const itemRows = _invStockSnapshotItemRows_({});
    const itemByCode = {};
    itemRows.forEach(function(item) {
      const code = _invNormalizeStockItemCode_(item.item_code);
      if (code && !itemByCode[code]) itemByCode[code] = item;
    });
    return rows.map(function(row) {
      const meta = itemByCode[_invNormalizeStockItemCode_(row.item_code)] || {};
      return Object.assign({}, row, {
        item_id: meta.id || '',
        uom: meta.uom || '',
        avg_rate: row.avgrate
      });
    });
  }
}

function _invStockAnalyticsMap_(itemIds, locationFilter) {
  const ids = [...new Set((itemIds || []).filter(Boolean))];
  const map = {};
  if (!ids.length) return map;

  const rows = _supabaseSelectByKeyInBatches_(
    'inv_stock_analytics_mv',
    'item_id,location,oldest_receipt_at,ageing_days,movement_class,next_batch_no,batch_count,avg_lead_time_days,avg_daily_consumption,safety_factor,minimum_stock_level',
    'item_id',
    ids,
    null,
    24
  ) || [];
  const locFilter = String(locationFilter || '').trim().toUpperCase();
  rows.forEach(function(row) {
    const loc = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
    if (locFilter && loc !== locFilter) return;
    map[String(row.item_id || '') + '|' + loc] = row;
  });
  return map;
}

function _invBuildStockSnapshotFromMV_(opts, includeAnalytics, snapshotLimit) {
  const locationFilter = String(opts && opts.location || '').trim().toUpperCase();
  const q = String(opts && opts.q || '').trim();
  const mvRows = _invSelectStockMVRows_()
    .filter(function(row) {
      const loc = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
      if (loc === 'FG') return false;
      if (locationFilter && loc !== locationFilter) return false;
      return _invSearchMatchesStockRow_(row, q);
    });

  const itemIds = includeAnalytics
    ? mvRows.map(function(row) { return row.item_id; }).filter(Boolean)
    : [];
  const analyticsMap = includeAnalytics ? _invStockAnalyticsMap_(itemIds, locationFilter) : {};
  const rows = mvRows.map(function(row) {
    const loc = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
    const analytics = analyticsMap[String(row.item_id || '') + '|' + loc] || {};
    const qty = Number(row.qty || 0);
    const msl = Number(analytics.minimum_stock_level || 0);
    return {
      itemCode: row.item_code || row.itemcode || '',
      itemName: row.item_name || row.itemname || '',
      category: row.category || '',
      department: row.department || '',
      uom: row.uom || '',
      itemId: row.item_id || '',
      location: loc,
      qty: qty,
      avgRate: Number(row.avg_rate || row.avgrate || 0),
      value: Number(row.value || 0),
      ageingDays: analytics.ageing_days == null ? null : Number(analytics.ageing_days),
      movementClass: analytics.movement_class || 'UNKNOWN',
      lastMovementAt: row.last_movement_at || '',
      oldestReceiptAt: analytics.oldest_receipt_at || '',
      nextBatchNo: analytics.next_batch_no || '',
      batchCount: Number(analytics.batch_count || 0),
      avgLeadTimeDays: Number(analytics.avg_lead_time_days || 0),
      avgDailyConsumption: Number(analytics.avg_daily_consumption || 0),
      safetyFactor: Number(analytics.safety_factor || 1.2),
      minimumStockLevel: msl,
      mslStatus: qty < msl ? 'BELOW_MSL' : 'OK',
      mslGap: Number((qty - msl).toFixed(2))
    };
  });

  return {
    ok: true,
    source: 'inv_stock_mv',
    rows: _invReconcileStockRows_(
      rows.slice(0, Math.max(1, Number(snapshotLimit || 1000000))),
      opts || {}
    )
  };
}

function invGetStockSnapshotJSON(opts = {}) {
  const includeAnalytics = opts.includeAnalytics === true;
  const forceRefresh = opts.forceRefresh === true;
  const requestedLimit = Number(opts.limit || 0);
  const snapshotLimit = requestedLimit > 0 ? Math.max(1, requestedLimit) : 1000000;
  const version = PropertiesService.getScriptProperties().getProperty('INV_STOCK_SNAPSHOT_VERSION') || '0';
  const cacheKey = _cacheKeyHash_('INV_STOCK_SNAPSHOT', JSON.stringify({
    v: version,
    reconcile: 8,
    q: String(opts.q || '').trim().toLowerCase(),
    l: String(opts.location || ''),
    n: snapshotLimit,
    a: includeAnalytics ? 1 : 0
  }));
  const cache = CacheService.getScriptCache();
  if (!forceRefresh) {
    const cached = cache.get(cacheKey);
    if (cached) {
      return JSON.parse(cached);
    }
  }

  try {
    refreshStockMV_(forceRefresh);
    const mvResult = _invBuildStockSnapshotFromMV_(opts, includeAnalytics, snapshotLimit);
    try {
      cache.put(cacheKey, JSON.stringify(mvResult), includeAnalytics ? 600 : 120);
    } catch (err) {}
    return mvResult;
  } catch (err) {
    Logger.log('Direct inv_stock_mv snapshot failed, falling back to RPC: ' + (err && err.message ? err.message : err));
  }

  try {
    const uiRows = supabaseRpc_('inv_stock_snapshot_ui', {
      p_location: opts.location || null,
      p_search: opts.q || null,
      p_limit: snapshotLimit
    }) || [];
    if (Array.isArray(uiRows) && uiRows.length >= 0) {
      const filteredUiRows = uiRows.filter(function(row) {
        return String(row.location || '').trim().toUpperCase() !== 'FG';
      });
      const result = {
        ok: true,
        rows: _invReconcileStockRows_(filteredUiRows.map(function(r) {
          return {
            itemCode: r.itemcode || '',
            itemName: r.itemname || '',
            category: r.category || '',
            department: r.department || '',
            uom: r.uom || '',
            itemId: r.item_id || '',
            location: r.location || '',
            qty: Number(r.qty || 0),
            avgRate: Number(r.avg_rate || r.avgrate || 0),
            value: Number(r.value || 0),
            ageingDays: r.ageing_days == null ? null : Number(r.ageing_days),
            movementClass: r.movement_class || 'UNKNOWN',
            lastMovementAt: r.last_movement_at || '',
            oldestReceiptAt: r.oldest_receipt_at || '',
            nextBatchNo: r.next_batch_no || '',
            batchCount: Number(r.batch_count || 0),
            avgLeadTimeDays: Number(r.avg_lead_time_days || 0),
            avgDailyConsumption: Number(r.avg_daily_consumption || 0),
            safetyFactor: Number(r.safety_factor || 1.2),
            minimumStockLevel: Number(r.minimum_stock_level || 0),
            mslStatus: r.msl_status || 'OK',
            mslGap: Number(r.msl_gap || 0)
          };
        }), opts)
      };
      try {
        cache.put(cacheKey, JSON.stringify(result), includeAnalytics ? 600 : 120);
      } catch (err) {}
      return result;
    }
  } catch (err) {}

  const AGEING_NON_MOVING_DAYS = 60;
  const AGEING_SLOW_MOVING_DAYS = 30;
  const CONSUMPTION_WINDOW_DAYS = 30;
  const DEFAULT_LEAD_TIME_DAYS = 7;
  const SAFETY_FACTOR = 1.2;
  const now = new Date();
  const consumptionCutoff = new Date(now.getTime() - (CONSUMPTION_WINDOW_DAYS * 24 * 60 * 60 * 1000));

  const snapshotRows = (supabaseRpc_('inv_stock_snapshot_mv', {
    p_location: opts.location || null,
    p_search: opts.q || null
  }) || [])
    .filter(function(row) {
      return String(row.location || '').trim().toUpperCase() !== 'FG';
    });
  let allSnapshotRows = snapshotRows.slice();

  const normalizeItemCode = code =>
    String(code || '').trim().toUpperCase();

  const itemMetaMap = {};
  const activeItemRows = _invStockSnapshotItemRows_(opts);
  activeItemRows.forEach(function(item) {
    const key = normalizeItemCode(item.item_code);
    if (!key || itemMetaMap[key]) return;
    itemMetaMap[key] = item;
  });

  const snapshotItemCodes = {};
  allSnapshotRows.forEach(function(row) {
    const key = normalizeItemCode(row.itemcode || row.item_code || '');
    if (key) snapshotItemCodes[key] = true;
  });
  const zeroStockRows = [];
  activeItemRows.forEach(function(item) {
    const itemCodeKey = normalizeItemCode(item.item_code);
    if (!itemCodeKey || snapshotItemCodes[itemCodeKey]) return;
    zeroStockRows.push({
      itemcode: item.item_code || '',
      itemname: item.item_name || '',
      category: item.category || '',
      department: item.department || '',
      uom: item.uom || '',
      location: (opts.location || DEFAULT_LOCATION || 'MAIN'),
      qty: 0,
      avgrate: 0,
      avg_rate: 0,
      value: 0,
      last_movement_at: null
    });
  });
  if (zeroStockRows.length) {
    allSnapshotRows = allSnapshotRows.concat(zeroStockRows);
  }

  const daysBetween = (start, end) =>
    Math.max(0, Math.ceil((end.getTime() - start.getTime()) / (24 * 60 * 60 * 1000)));

  if (!includeAnalytics) {
    const quickRows = allSnapshotRows.map(function(r) {
      const itemCode = r.itemcode || r.item_code || '';
      const meta = itemMetaMap[normalizeItemCode(itemCode)] || {};
      const effectiveLastMovementAt = r.last_movement_at ? new Date(r.last_movement_at) : null;
      const ageingDays = effectiveLastMovementAt ? daysBetween(effectiveLastMovementAt, now) : null;
      const movementClass = ageingDays === null
        ? 'UNKNOWN'
        : ageingDays > AGEING_NON_MOVING_DAYS
          ? 'NON_MOVING'
          : ageingDays > AGEING_SLOW_MOVING_DAYS
            ? 'SLOW_MOVING'
            : 'FAST_MOVING';
      return {
      itemCode: itemCode,
      itemName: r.itemname || r.item_name || '',
      category: meta.category || r.category || '',
      department: meta.department || r.department || '',
      uom: meta.uom || r.uom || '',
      itemId: meta.id || '',
      location: r.location || '',
      qty: Number(r.qty || 0),
        avgRate: Number(r.avgrate || r.avg_rate || 0),
        value: Number(r.value || 0),
        ageingDays: ageingDays,
        movementClass: movementClass,
        lastMovementAt: effectiveLastMovementAt ? effectiveLastMovementAt.toISOString() : '',
        oldestReceiptAt: '',
        nextBatchNo: '',
        batchCount: 0,
        avgLeadTimeDays: 0,
        avgDailyConsumption: 0,
        safetyFactor: SAFETY_FACTOR,
        minimumStockLevel: 0,
        mslStatus: 'OK',
        mslGap: Number(r.qty || 0)
      };
    });
    const quickResult = { ok: true, rows: _invReconcileStockRows_(quickRows, opts) };
    try {
      cache.put(cacheKey, JSON.stringify(quickResult), 120);
    } catch (err) {}
    return quickResult;
  }

  const itemIds = [...new Set(allSnapshotRows
    .map(r => {
      const meta = itemMetaMap[normalizeItemCode(r.itemcode || r.item_code || '')] || {};
      return meta.id;
    })
    .filter(Boolean))];
  const consumptionMap = {};
  const prMap = {};
  const receiptMap = {};
  const lotMap = {};
  const purchaseAvgRateMap = invGetPurchaseAvgRateMap_(itemIds, opts.location || DEFAULT_LOCATION);

  if (itemIds.length) {
    const chunkSize = 200;
    const receiptPrNosAll = [];

    for (let i = 0; i < itemIds.length; i += chunkSize) {
      const chunk = itemIds.slice(i, i + chunkSize);

      const lotRows = supabaseSelect_('inv_lots', {
        select: 'item_id,batch_no,receipt_date,qty_available',
        filters: {
          item_id: _supabaseInFilter_(chunk),
          location: 'eq.' + (opts.location || DEFAULT_LOCATION),
          qty_available: 'gt.0'
        },
        order: 'receipt_date.asc,created_at.asc',
        limit: 5000
      }) || [];

      lotRows.forEach(lot => {
        const itemId = lot.item_id;
        if (!itemId) return;
        if (!lotMap[itemId]) {
          lotMap[itemId] = {
            oldestReceiptAt: null,
            nextBatchNo: '',
            batchCount: 0
          };
        }
        lotMap[itemId].batchCount += 1;
        const receiptAt = lot.receipt_date ? new Date(lot.receipt_date) : null;
        if (receiptAt && (!lotMap[itemId].oldestReceiptAt || receiptAt < lotMap[itemId].oldestReceiptAt)) {
          lotMap[itemId].oldestReceiptAt = receiptAt;
          lotMap[itemId].nextBatchNo = String(lot.batch_no || '').trim();
        }
      });

      const issueRows = supabaseSelect_('inv_ledger', {
        select: 'item_id, qty_out',
        filters: {
          item_id: _supabaseInFilter_(chunk),
          ref_type: 'eq.ISSUE',
          created_at: 'gte.' + consumptionCutoff.toISOString()
        },
        limit: 5000
      }) || [];
      issueRows.forEach(function(entry) {
        if (!entry.item_id) return;
        consumptionMap[entry.item_id] =
          (consumptionMap[entry.item_id] || 0) + Number(entry.qty_out || 0);
      });

      const receiptRows = supabaseSelect_('inv_ledger', {
        select: 'item_id, created_at, ref_no',
        filters: {
          item_id: _supabaseInFilter_(chunk),
          ref_type: 'eq.PR-RECEIPT'
        },
        order: 'created_at.asc',
        limit: 5000
      }) || [];
      receiptRows.forEach(function(entry) {
        if (!entry.item_id || !entry.created_at || !entry.ref_no) return;
        const prNo = String(entry.ref_no || '').trim();
        if (!prNo) return;
        if (receiptPrNosAll.indexOf(prNo) === -1) {
          receiptPrNosAll.push(prNo);
        }
        const ts = new Date(entry.created_at);
        const key = String(entry.item_id) + '|' + prNo;
        const currentReceipt = receiptMap[key];
        if (!currentReceipt || ts < currentReceipt) {
          receiptMap[key] = ts;
        }
      });
    }

    if (receiptPrNosAll.length) {
      const prChunkSize = 200;
      for (let j = 0; j < receiptPrNosAll.length; j += prChunkSize) {
        const prChunk = receiptPrNosAll.slice(j, j + prChunkSize);
        const purchaseRequests = supabaseSelect_('inv_purchase_requests', {
          select: 'item_id, pr_no, created_at',
          filters: {
            pr_no: _supabaseInFilter_(prChunk)
          }
        }) || [];

        purchaseRequests.forEach(function(pr) {
          if (!pr.item_id || !pr.pr_no || !pr.created_at) return;
          if (!prMap[pr.item_id]) prMap[pr.item_id] = [];
          prMap[pr.item_id].push({
            prNo: pr.pr_no,
            createdAt: new Date(pr.created_at)
          });
        });
      }
    }
  }

  const resultRows = allSnapshotRows.map(r => {
    const itemCode = r.itemcode || r.item_code || '';
    const meta = itemMetaMap[normalizeItemCode(itemCode)] || {};
    const itemId = meta.id;
    const lotInfo = itemId ? lotMap[itemId] : null;
    const effectiveLastMovementAt = r.last_movement_at ? new Date(r.last_movement_at) : null;
    const oldestReceiptAt = lotInfo?.oldestReceiptAt || null;
    const ageingBase = oldestReceiptAt || effectiveLastMovementAt;
    const ageingDays = ageingBase ? daysBetween(ageingBase, now) : null;
    const movementClass = ageingDays === null
      ? (meta.active === false ? 'INACTIVE' : 'UNKNOWN')
      : ageingDays > AGEING_NON_MOVING_DAYS
        ? 'NON_MOVING'
        : ageingDays > AGEING_SLOW_MOVING_DAYS
          ? 'SLOW_MOVING'
          : 'FAST_MOVING';
    const totalConsumption = itemId ? Number(consumptionMap[itemId] || 0) : 0;
    const avgDailyConsumption = totalConsumption / CONSUMPTION_WINDOW_DAYS;
    const leadTimes = (prMap[itemId] || [])
      .map(pr => {
        const receiptAt = receiptMap[String(itemId) + '|' + pr.prNo];
        return receiptAt ? daysBetween(pr.createdAt, receiptAt) : null;
      })
      .filter(v => v !== null);
    const avgLeadTimeDays = leadTimes.length
      ? leadTimes.reduce((sum, days) => sum + days, 0) / leadTimes.length
      : DEFAULT_LEAD_TIME_DAYS;
    const msl = avgLeadTimeDays * avgDailyConsumption * SAFETY_FACTOR;
    const qty = Number(r.qty || 0);
    const avgRate = Number(purchaseAvgRateMap[itemId] || r.avgrate || r.avg_rate || 0);
    const value = Number(r.value || 0);

    return {
      itemCode: itemCode,
      itemName: r.itemname || r.item_name || '',
      category: meta.category || r.category || '',
      department: meta.department || r.department || '',
      uom: meta.uom || r.uom || '',
      itemId: itemId || '',
      location: r.location || '',
      qty: qty,
      avgRate: avgRate,
      value: value,
      ageingDays: ageingDays,
      movementClass: movementClass,
      lastMovementAt: effectiveLastMovementAt ? effectiveLastMovementAt.toISOString() : '',
      oldestReceiptAt: oldestReceiptAt ? oldestReceiptAt.toISOString() : '',
      nextBatchNo: lotInfo?.nextBatchNo || '',
      batchCount: Number(lotInfo?.batchCount || 0),
      avgLeadTimeDays: Number(avgLeadTimeDays.toFixed(2)),
      avgDailyConsumption: Number(avgDailyConsumption.toFixed(4)),
      safetyFactor: SAFETY_FACTOR,
      minimumStockLevel: Number(msl.toFixed(2)),
      mslStatus: qty < msl ? 'BELOW_MSL' : 'OK',
      mslGap: Number((qty - msl).toFixed(2))
    };
  });

  const result = {
    ok: true,
    rows: _invReconcileStockRows_(resultRows, opts)
  };

  try {
    cache.put(cacheKey, JSON.stringify(result), 600);
  } catch (err) {}
  return result;
}

function _invReplenishmentRound_(value, decimals) {
  const n = Number(value || 0);
  const places = Math.max(0, Number(decimals || 0));
  const factor = Math.pow(10, places);
  return Math.round((Number.isFinite(n) ? n : 0) * factor) / factor;
}

function _invIsIntegerUom_(uom) {
  const key = String(uom || '').trim().toUpperCase();
  return ['PCS', 'PC', 'PIECE', 'PIECES', 'NOS', 'NO', 'NO.', 'EA', 'EACH', 'UNIT', 'UNITS'].indexOf(key) !== -1;
}

function _invReplenishmentQtyForUom_(value, uom, decimals) {
  const n = Math.max(0, Number(value || 0));
  if (_invIsIntegerUom_(uom)) return Math.ceil(n);
  return _invReplenishmentRound_(n, decimals || 3);
}

function _invMapReplenishmentSqlRow_(row) {
  const existingPrNos = String(row.existing_pr_nos || '')
    .split(',')
    .map(function(v) { return v.trim(); })
    .filter(Boolean);
  const existingPoNos = String(row.existing_po_nos || '')
    .split(',')
    .map(function(v) { return v.trim(); })
    .filter(Boolean);
  return {
    itemId: String(row.item_id || ''),
    itemCode: String(row.item_code || '').trim(),
    itemName: String(row.item_name || '').trim(),
    category: String(row.category || '').trim(),
    department: String(row.department || '').trim(),
    uom: String(row.uom || '').trim(),
    location: String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN',
    isActive: row.is_active === false ? false : true,
    stockManaged: row.stock_managed === false ? false : true,
    isConsumable: row.is_consumable === true,
    integerUom: row.integer_uom === true,
    manualLeadTimeDays: row.manual_lead_time_days === null || typeof row.manual_lead_time_days === 'undefined' ? '' : Number(row.manual_lead_time_days),
    historicalLeadTimeDays: 0,
    effectiveLeadTimeDays: Number(row.effective_lead_time_days || 0),
    moqQty: Number(row.moq_qty || 0),
    consumptionWindowDays: Number(row.consumption_window_days || 30),
    totalConsumptionQty: Number(row.total_consumption_qty || 0),
    avgDailyConsumption: Number(row.avg_daily_consumption || 0),
    safetyFactor: Number(row.safety_factor || 1.2),
    minimumStockLevel: Number(row.minimum_stock_level || 0),
    currentStockQty: Number(row.current_stock_qty || 0),
    openPrQty: Number(row.open_pr_qty || 0),
    openPoQty: Number(row.open_po_qty || 0),
    pipelineQty: Number(row.pipeline_qty || 0),
    reservedQty: Number(row.reserved_qty || 0),
    netAvailableQty: Number(row.net_available_qty || 0),
    shortageQty: Number(row.shortage_qty || 0),
    suggestedPrQty: Number(row.suggested_pr_qty || 0),
    alertLevel: String(row.alert_level || 'OK').trim().toUpperCase() || 'OK',
    canCreatePr: row.can_create_pr === true,
    existingPrNos: existingPrNos,
    existingPoNos: existingPoNos,
    reason: String(row.reason || '').trim()
  };
}

function _invReadReplenishmentRowsFromSupabase_(request) {
  const rows = supabaseRpc_('inv_replenishment_snapshot_ui', {
    p_search: request && request.q ? String(request.q || '').trim() : null,
    p_alert: request && request.alert ? String(request.alert || '').trim() : null,
    p_limit: Math.max(1, Number(request && request.limit || 50000) || 50000)
  }) || [];
  const allocationMap = _invStockAllocationTotalsMap_(request || {});
  return rows.map(_invMapReplenishmentSqlRow_).map(function(row) {
    const loc = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
    const code = String(row.itemCode || '').trim().toUpperCase();
    const allocation = allocationMap['ID|' + String(row.itemId || '') + '|' + loc] ||
      allocationMap['CODE|' + code + '|' + loc] || { allocatedQty: 0 };
    const reservedQty = Math.max(0, Number(allocation.allocatedQty || 0));
    const netAvailableQty = _invReplenishmentRound_(
      Number(row.currentStockQty || 0) + Number(row.pipelineQty || 0) - reservedQty,
      3
    );
    const shortageQty = _invReplenishmentQtyForUom_(
      Math.max(0, Number(row.minimumStockLevel || 0) - netAvailableQty),
      row.uom,
      3
    );
    const suggestedPrQty = shortageQty > 0
      ? _invReplenishmentQtyForUom_(Math.max(shortageQty, Number(row.moqQty || 0)), row.uom, 3)
      : 0;
    row.reservedQty = reservedQty;
    row.freeStockQty = Math.max(0, Number(row.currentStockQty || 0) - reservedQty);
    row.netAvailableQty = netAvailableQty;
    row.shortageQty = shortageQty;
    row.suggestedPrQty = suggestedPrQty;
    row.canCreatePr = row.isActive && row.stockManaged &&
      Number(row.effectiveLeadTimeDays || 0) > 0 &&
      Number(row.avgDailyConsumption || 0) > 0 && suggestedPrQty > 0;
    if (reservedQty > 0 && suggestedPrQty > 0) {
      row.reason = 'PR required after active Work Order allocations';
    }
    return row;
  });
}

function _invReplenishmentConsumptionMap_(itemIds, location, windowDays) {
  const ids = [...new Set((itemIds || []).filter(Boolean))];
  const map = {};
  if (!ids.length) return map;

  const days = Math.max(1, Number(windowDays || 30) || 30);
  const cutoff = new Date(Date.now() - (days * 24 * 60 * 60 * 1000)).toISOString();
  const locFilter = String(location || '').trim().toUpperCase();
  const chunks = _supabaseChunkValuesByFilterLength_(ids, 900, 24);

  chunks.forEach(function(chunk) {
    const filters = {
      item_id: _supabaseInFilter_(chunk),
      ref_type: 'eq.ISSUE',
      created_at: 'gte.' + cutoff
    };
    if (locFilter) filters.location = 'eq.' + locFilter;

    (_supabaseSelectAll_('inv_ledger', {
      select: 'item_id,location,qty_out',
      filters: filters
    }, 1000, 50000) || []).forEach(function(row) {
      const itemId = String(row.item_id || '').trim();
      if (!itemId) return;
      const loc = String(row.location || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
      const key = itemId + '|' + (locFilter || loc);
      map[key] = Number(map[key] || 0) + Number(row.qty_out || 0);
    });
  });

  return map;
}

function _invOpenProcurementCoverageMap_(opts) {
  const map = {};
  const forceRefresh = !!(opts && opts.forceRefresh === true);
  let rows = [];
  try {
    rows = purchaseListInventoryRequestsJSON({
      status: 'OPEN',
      pendingOnly: false,
      limit: 50000,
      forceRefresh: forceRefresh
    }).rows || [];
  } catch (err) {
    rows = [];
  }

  rows.forEach(function(row) {
    const status = String(row.status || row.prStatus || '').trim().toUpperCase();
    const lifecycle = String(row.lifecycleStatus || row.displayStatus || '').trim().toUpperCase();
    if (['CANCELLED', 'PR_CANCELLED', 'PR_SHORT_CLOSED', 'PR_CLOSED', 'CLOSED', 'MATERIAL_RECEIVED'].indexOf(status) !== -1) return;
    if (['PR_CANCELLED', 'PR_SHORT_CLOSED', 'PR_CLOSED', 'MATERIAL_RECEIVED'].indexOf(lifecycle) !== -1) return;

    const itemCode = _invNormalizeStockItemCode_(row.itemCode || row.item_code);
    if (!itemCode) return;

    const requestedQty = Number(row.requestedQty ?? row.prQty ?? row.requested_qty ?? 0);
    const receivedQty = Number(row.receivedQty ?? row.received_qty ?? 0);
    const pendingReceiptQty = Math.max(0, Number(row.pendingReceiptQty ?? row.balanceQty ?? row.pendingQty ?? (requestedQty - receivedQty)) || 0);
    if (pendingReceiptQty <= 0.0001) return;

    const openPOQty = Math.max(0, Number(row.openPOQty ?? row.poQty ?? 0) || 0);
    const availableToOrderQty = Math.max(0, Number(row.availableToOrderQty ?? Math.max(0, pendingReceiptQty - openPOQty)) || 0);
    if (!map[itemCode]) {
      map[itemCode] = {
        pipelineQty: 0,
        openPrQty: 0,
        openPoQty: 0,
        prNos: [],
        poRefs: []
      };
    }

    map[itemCode].pipelineQty += pendingReceiptQty;
    map[itemCode].openPrQty += availableToOrderQty;
    map[itemCode].openPoQty += openPOQty;
    if (row.prNo && map[itemCode].prNos.indexOf(row.prNo) === -1) map[itemCode].prNos.push(row.prNo);
    (row.poRefs || row.refs || []).forEach(function(ref) {
      const poNo = String(ref || '').trim();
      if (poNo && map[itemCode].poRefs.indexOf(poNo) === -1) map[itemCode].poRefs.push(poNo);
    });
  });

  Object.keys(map).forEach(function(key) {
    map[key].pipelineQty = _invReplenishmentRound_(map[key].pipelineQty, 3);
    map[key].openPrQty = _invReplenishmentRound_(map[key].openPrQty, 3);
    map[key].openPoQty = _invReplenishmentRound_(map[key].openPoQty, 3);
  });
  return map;
}

function _invReplenishmentAlertLevel_(ctx) {
  if (!ctx.stockManaged || !ctx.isActive) return 'INACTIVE';
  if (!ctx.hasLeadTime || Number(ctx.effectiveLeadTimeDays || 0) <= 0) return 'MISSING_LEAD_TIME';
  if (Number(ctx.avgDailyConsumption || 0) <= 0) return 'NO_CONSUMPTION';
  if (Number(ctx.suggestedPrQty || 0) > 0 && Number(ctx.currentStockQty || 0) <= 0) return 'CRITICAL';
  if (Number(ctx.suggestedPrQty || 0) > 0) return 'REORDER';
  if (Number(ctx.currentStockQty || 0) < Number(ctx.minimumStockLevel || 0)) return 'WATCH';
  return 'OK';
}

function _invBuildReplenishmentRows_(opts) {
  const options = opts || {};
  const consumptionWindowDays = Math.max(1, Number(options.consumptionWindowDays || 30) || 30);
  const safetyFactor = Math.max(0, Number(options.safetyFactor || 1.2) || 1.2);
  const snapshot = invGetStockSnapshotJSON({
    q: options.q || '',
    location: options.location || '',
    includeAnalytics: true,
    forceRefresh: options.forceRefresh === true,
    limit: Math.max(1, Number(options.limit || 50000) || 50000)
  }) || { rows: [] };

  const rows = snapshot.rows || [];
  const itemIds = rows.map(function(row) { return String(row.itemId || '').trim(); }).filter(Boolean);
  const consumptionMap = _invReplenishmentConsumptionMap_(itemIds, options.location || '', consumptionWindowDays);
  const coverageMap = _invOpenProcurementCoverageMap_(options);
  const locFilter = String(options.location || '').trim().toUpperCase();

  return rows.map(function(row) {
    const itemCode = _invNormalizeStockItemCode_(row.itemCode || row.item_code);
    const location = String(row.location || locFilter || DEFAULT_LOCATION || 'MAIN').trim().toUpperCase() || 'MAIN';
    const itemId = String(row.itemId || '').trim();
    const totalConsumption = itemId ? Number(consumptionMap[itemId + '|' + (locFilter || location)] || 0) : 0;
    const computedDaily = totalConsumption > 0 ? (totalConsumption / consumptionWindowDays) : Number(row.avgDailyConsumption || 0);
    const manualLeadRaw = row.manualLeadTimeDays;
    const manualLeadTimeDays = manualLeadRaw === '' || manualLeadRaw === null || typeof manualLeadRaw === 'undefined'
      ? null
      : Number(manualLeadRaw);
    const historicalLeadTimeDays = Number(row.avgLeadTimeDays || 0);
    const hasLeadTime = manualLeadTimeDays !== null && Number.isFinite(manualLeadTimeDays) && manualLeadTimeDays > 0;
    const effectiveLeadTimeDays = hasLeadTime ? manualLeadTimeDays : 0;
    const rawMoqQty = row.moqQty === '' || row.moqQty === null || typeof row.moqQty === 'undefined'
      ? 0
      : Math.max(0, Number(row.moqQty || 0));
    const integerUom = _invIsIntegerUom_(row.uom);
    const moqQty = _invReplenishmentQtyForUom_(rawMoqQty, row.uom, 3);
    const currentStockQty = Number(row.qty || 0);
    const coverage = coverageMap[itemCode] || { pipelineQty: 0, openPrQty: 0, openPoQty: 0, prNos: [], poRefs: [] };
    const reservedQty = Math.max(0, Number(row.allocatedQty || 0));
    const rawMsl = effectiveLeadTimeDays * computedDaily * safetyFactor;
    const minimumStockLevel = integerUom
      ? _invReplenishmentQtyForUom_(rawMsl, row.uom, 0)
      : _invReplenishmentRound_(rawMsl, 2);
    const netAvailableQty = _invReplenishmentRound_(currentStockQty + Number(coverage.pipelineQty || 0) - reservedQty, 3);
    const shortageQty = _invReplenishmentQtyForUom_(Math.max(0, minimumStockLevel - netAvailableQty), row.uom, 3);
    const suggestedPrQty = shortageQty > 0 ? _invReplenishmentQtyForUom_(Math.max(shortageQty, moqQty), row.uom, 3) : 0;
    const stockManaged = row.stockManaged === false ? false : true;
    const isActive = row.isActive === false ? false : true;
    const canCreatePr = isActive && stockManaged && hasLeadTime && computedDaily > 0 && suggestedPrQty > 0;
    const alertLevel = _invReplenishmentAlertLevel_({
      stockManaged: stockManaged,
      isActive: isActive,
      hasLeadTime: hasLeadTime,
      effectiveLeadTimeDays: effectiveLeadTimeDays,
      avgDailyConsumption: computedDaily,
      suggestedPrQty: suggestedPrQty,
      currentStockQty: currentStockQty,
      minimumStockLevel: minimumStockLevel
    });

    return {
      itemId: itemId,
      itemCode: row.itemCode || '',
      itemName: row.itemName || '',
      category: row.category || '',
      department: row.department || '',
      uom: row.uom || '',
      location: location,
      isActive: isActive,
      stockManaged: stockManaged,
      isConsumable: row.isConsumable === true,
      integerUom: integerUom,
      manualLeadTimeDays: hasLeadTime ? manualLeadTimeDays : '',
      historicalLeadTimeDays: _invReplenishmentRound_(historicalLeadTimeDays, 2),
      effectiveLeadTimeDays: _invReplenishmentRound_(effectiveLeadTimeDays, 2),
      moqQty: _invReplenishmentRound_(moqQty, 3),
      consumptionWindowDays: consumptionWindowDays,
      totalConsumptionQty: _invReplenishmentRound_(totalConsumption, 3),
      avgDailyConsumption: _invReplenishmentRound_(computedDaily, 4),
      safetyFactor: safetyFactor,
      minimumStockLevel: minimumStockLevel,
      currentStockQty: _invReplenishmentRound_(currentStockQty, 3),
      openPrQty: Number(coverage.openPrQty || 0),
      openPoQty: Number(coverage.openPoQty || 0),
      pipelineQty: Number(coverage.pipelineQty || 0),
      reservedQty: reservedQty,
      freeStockQty: Math.max(0, currentStockQty - reservedQty),
      netAvailableQty: netAvailableQty,
      shortageQty: shortageQty,
      suggestedPrQty: suggestedPrQty,
      alertLevel: alertLevel,
      canCreatePr: canCreatePr,
      existingPrNos: coverage.prNos || [],
      existingPoNos: coverage.poRefs || [],
      reason: alertLevel === 'MISSING_LEAD_TIME'
        ? 'Lead time missing in item master'
        : (alertLevel === 'NO_CONSUMPTION'
            ? 'No issue consumption in the selected window'
            : (alertLevel === 'WATCH'
                ? 'Stock is below MSL but open PR/PO covers the gap'
                : (canCreatePr ? 'PR required for uncovered MSL shortage' : alertLevel)))
    };
  }).sort(function(a, b) {
    const rank = { CRITICAL: 0, REORDER: 1, WATCH: 2, MISSING_LEAD_TIME: 3, NO_CONSUMPTION: 4, OK: 5, INACTIVE: 6 };
    return (rank[a.alertLevel] ?? 9) - (rank[b.alertLevel] ?? 9) ||
      String(a.itemName || a.itemCode || '').localeCompare(String(b.itemName || b.itemCode || ''));
  });
}

function invGetReplenishmentSnapshotJSON(opts = {}) {
  const request = {
    q: String(opts.q || '').trim(),
    alert: String(opts.alert || '').trim(),
    location: String(opts.location || '').trim(),
    forceRefresh: opts.forceRefresh === true,
    limit: Math.max(1, Number(opts.limit || 50000) || 50000),
    safetyFactor: Math.max(0, Number(opts.safetyFactor || 1.2) || 1.2),
    consumptionWindowDays: Math.max(1, Number(opts.consumptionWindowDays || 30) || 30)
  };
  let rows = null;
  try {
    rows = _invReadReplenishmentRowsFromSupabase_(request);
  } catch (err) {
    Logger.log('Supabase replenishment read model unavailable, using GAS fallback: ' + (err && err.message ? err.message : err));
    rows = null;
  }
  if (rows === null) rows = _invBuildReplenishmentRows_(request);
  const summary = rows.reduce(function(acc, row) {
    acc.total += 1;
    acc.suggestedPrQty += Number(row.suggestedPrQty || 0);
    acc.shortageQty += Number(row.shortageQty || 0);
    acc[row.alertLevel] = Number(acc[row.alertLevel] || 0) + 1;
    if (row.canCreatePr) acc.actionable += 1;
    return acc;
  }, { total: 0, actionable: 0, suggestedPrQty: 0, shortageQty: 0 });

  summary.suggestedPrQty = _invReplenishmentRound_(summary.suggestedPrQty, 3);
  summary.shortageQty = _invReplenishmentRound_(summary.shortageQty, 3);
  return {
    ok: true,
    rows: rows,
    summary: summary,
    generatedAt: new Date().toISOString()
  };
}

function invCreateReplenishmentPRs(payload, token) {
  const sessionUser = _requireAnyModuleAccess_(_authTokenFromPayload_(payload, token), [
    { module: 'INVENTORY', action: 'can_create' },
    { module: 'PURCHASE', action: 'can_create' }
  ]);
  const selectedCodes = [...new Set((Array.isArray(payload && payload.itemCodes) ? payload.itemCodes : [])
    .map(function(code) { return _invNormalizeStockItemCode_(code); })
    .filter(Boolean))];
  if (!selectedCodes.length) throw new Error('Select at least one replenishment item.');

  const reviewedBy = _authActorName_(sessionUser);
  const request = {
    q: '',
    location: payload && payload.location || '',
    forceRefresh: true,
    limit: 50000,
    safetyFactor: payload && payload.safetyFactor || 1.2,
    consumptionWindowDays: payload && payload.consumptionWindowDays || 30
  };
  let snapshotRows = null;
  try {
    snapshotRows = _invReadReplenishmentRowsFromSupabase_(request);
  } catch (err) {
    Logger.log('Supabase replenishment create validation unavailable, using GAS fallback: ' + (err && err.message ? err.message : err));
    snapshotRows = null;
  }
  if (snapshotRows === null) snapshotRows = _invBuildReplenishmentRows_(request);
  const byCode = {};
  snapshotRows.forEach(function(row) {
    const code = _invNormalizeStockItemCode_(row.itemCode);
    if (code) byCode[code] = row;
  });

  const rows = selectedCodes.map(function(code) {
    const row = byCode[code];
    if (!row) throw new Error('Replenishment row not found for item ' + code);
    if (!row.canCreatePr || !(Number(row.suggestedPrQty || 0) > 0)) {
      throw new Error('Suggested PR is not currently required for item ' + (row.itemCode || code));
    }
    return {
      itemCode: row.itemCode,
      itemName: row.itemName,
      prQty: Number(row.suggestedPrQty || 0),
      prDept: row.department || 'Stores',
      jobRef: 'MSL-REPLENISHMENT',
      remarks: [
        'Auto-suggested by MSL review',
        'MSL ' + row.minimumStockLevel,
        'Stock ' + row.currentStockQty,
        'Pipeline ' + row.pipelineQty,
        'Shortage ' + row.shortageQty,
        'Reviewed by ' + reviewedBy
      ].join(' | ')
    };
  });

  const requestKey = 'REPLENISH-' + Date.now() + '-' + Utilities.getUuid().slice(0, 8).toUpperCase();
  const result = invCreatePurchaseRequestsBulk({
    requestKey: requestKey,
    rows: rows
  }, token);
  PropertiesService.getScriptProperties().setProperty('PURCHASE_CACHE_VERSION', String(Date.now()));
  PropertiesService.getScriptProperties().setProperty('INV_STOCK_SNAPSHOT_VERSION', String(Date.now()));
  return Object.assign({}, result, {
    replenishment: true,
    rows: rows.map(function(row, idx) {
      return {
        prNo: result.prNos && result.prNos[idx] || '',
        itemCode: row.itemCode,
        itemName: row.itemName,
        prQty: row.prQty,
        department: row.prDept
      };
    })
  });
}

