function _salesCommandPeriodTotals_(reps, key) {
  const suffix = String(key || 'Mtd');
  const orderKey = 'orderValue' + suffix;
  const billingKey = 'billingValue' + suffix;
  const ordersKey = 'orders' + suffix;
  return (reps || []).reduce(function(out, row) {
    out.orderValue += _salesCommandNumber_(row[orderKey]);
    out.billingValue += _salesCommandNumber_(row[billingKey]);
    out.orderCount += _salesCommandNumber_(row[ordersKey]);
    return out;
  }, { orderValue: 0, billingValue: 0, orderCount: 0 });
}

function _salesCommandDivisionLabel_(value) {
  const text = String(value || '').trim();
  return text || 'UNASSIGNED';
}

function _salesCommandDateInRange_(dateText, fromDate, toDate) {
  const text = String(dateText || '').slice(0, 10);
  return !!text && text >= fromDate && text <= toDate;
}

function _salesCommandEmptyDivision_(name) {
  return {
    division: name,
    orderValueToday: 0,
    orderValueWtd: 0,
    orderValueMtd: 0,
    billingValueToday: 0,
    billingValueWtd: 0,
    billingValueMtd: 0,
    ordersToday: 0,
    ordersWtd: 0,
    ordersMtd: 0,
    billedLinesToday: 0,
    billedLinesWtd: 0,
    billedLinesMtd: 0,
    purchaseValueToday: 0,
    purchaseValueWtd: 0,
    purchaseValueMtd: 0,
    purchaseLinesToday: 0,
    purchaseLinesWtd: 0,
    purchaseLinesMtd: 0,
    backlogValue: 0,
    openQty: 0,
    openLines: 0
  };
}

function _salesCommandIsCommonPurchaseBucket_(value) {
  const text = String(value || '').trim().toUpperCase();
  if (!text) return true;
  return text === 'UNASSIGNED' ||
    text === 'GENERAL' ||
    text === 'COMMON' ||
    text === 'ADMIN' ||
    text === 'OFFICE' ||
    text === 'STORE' ||
    text === 'STORES' ||
    text.indexOf('GENERAL') !== -1 ||
    text.indexOf('COMMON') !== -1 ||
    text.indexOf('ADMIN') !== -1 ||
    text.indexOf('OFFICE') !== -1;
}

function _salesCommandPurchaseRatioPct_(purchaseValue, salesValue) {
  const sales = _salesCommandNumber_(salesValue);
  if (sales <= 0) return null;
  return Math.round(_salesCommandNumber_(purchaseValue) / sales * 1000) / 10;
}

function _salesCommandBuildPurchaseRatio_(divisions, purchaseRows, bounds) {
  const map = {};
  (divisions || []).forEach(function(row) {
    const key = _salesCommandDivisionLabel_(row.division);
    map[key] = Object.assign({}, row);
  });
  const common = _salesCommandEmptyDivision_('General / Common');
  (purchaseRows || []).forEach(function(row) {
    const rawDepartment = row.department || row.division || '';
    const isCommon = _salesCommandIsCommonPurchaseBucket_(rawDepartment);
    const key = isCommon ? common.division : _salesCommandDivisionLabel_(rawDepartment);
    if (!isCommon && !map[key]) map[key] = _salesCommandEmptyDivision_(key);
    const bucket = isCommon ? common : map[key];
    const dateText = String(row.grn_date || row.receipt_date || '').slice(0, 10);
    const value = _salesCommandNumber_(row.total_value || row.totalValue || row.basic_value);
    if (_salesCommandDateInRange_(dateText, bounds.today, bounds.today)) {
      bucket.purchaseValueToday += value;
      bucket.purchaseLinesToday += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.weekStart, bounds.today)) {
      bucket.purchaseValueWtd += value;
      bucket.purchaseLinesWtd += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.monthStart, bounds.today)) {
      bucket.purchaseValueMtd += value;
      bucket.purchaseLinesMtd += 1;
    }
  });
  const rows = Object.keys(map).map(function(key) {
    const row = map[key];
    row.purchaseToSalesTodayPct = _salesCommandPurchaseRatioPct_(row.purchaseValueToday, row.billingValueToday);
    row.purchaseToSalesWtdPct = _salesCommandPurchaseRatioPct_(row.purchaseValueWtd, row.billingValueWtd);
    row.purchaseToSalesMtdPct = _salesCommandPurchaseRatioPct_(row.purchaseValueMtd, row.billingValueMtd);
    return row;
  }).filter(function(row) {
    return row.billingValueMtd || row.purchaseValueMtd || row.billingValueWtd || row.purchaseValueWtd;
  }).sort(function(a, b) {
    return _salesCommandNumber_(b.purchaseValueMtd) - _salesCommandNumber_(a.purchaseValueMtd) ||
      _salesCommandNumber_(b.billingValueMtd) - _salesCommandNumber_(a.billingValueMtd) ||
      a.division.localeCompare(b.division);
  });
  const totals = rows.reduce(function(out, row) {
    out.purchaseValueToday += row.purchaseValueToday;
    out.purchaseValueWtd += row.purchaseValueWtd;
    out.purchaseValueMtd += row.purchaseValueMtd;
    out.salesValueToday += row.billingValueToday;
    out.salesValueWtd += row.billingValueWtd;
    out.salesValueMtd += row.billingValueMtd;
    out.purchaseLinesMtd += row.purchaseLinesMtd;
    return out;
  }, {
    purchaseValueToday: 0,
    purchaseValueWtd: 0,
    purchaseValueMtd: 0,
    salesValueToday: 0,
    salesValueWtd: 0,
    salesValueMtd: 0,
    purchaseLinesMtd: 0
  });
  ['Today', 'Wtd', 'Mtd'].forEach(function(period) {
    totals['commonPurchaseValue' + period] = common['purchaseValue' + period];
    totals['totalPurchaseValue' + period] = totals['purchaseValue' + period] + common['purchaseValue' + period];
    totals['ratio' + period + 'Pct'] = _salesCommandPurchaseRatioPct_(
      totals['totalPurchaseValue' + period],
      totals['salesValue' + period]
    );
  });
  common.purchaseToSalesTodayPct = _salesCommandPurchaseRatioPct_(common.purchaseValueToday, totals.salesValueToday);
  common.purchaseToSalesWtdPct = _salesCommandPurchaseRatioPct_(common.purchaseValueWtd, totals.salesValueWtd);
  common.purchaseToSalesMtdPct = _salesCommandPurchaseRatioPct_(common.purchaseValueMtd, totals.salesValueMtd);
  return {
    rows: rows,
    common: common,
    totals: totals,
    note: 'Purchase is based on posted GRN/MRN total value; reversed inventory receipts are excluded by v_report_department_purchase_grn. General/common purchases are excluded from division rows but included in total purchase-to-sales ratio.'
  };
}

function _salesCommandBuildDivisions_(orderRows, billingRows, openRows, bounds) {
  const map = {};
  function get(name) {
    const key = _salesCommandDivisionLabel_(name);
    if (!map[key]) map[key] = _salesCommandEmptyDivision_(key);
    return map[key];
  }
  (orderRows || []).forEach(function(row) {
    const division = get(row.division);
    const dateText = String(row.so_date || '').slice(0, 10);
    const value = _salesCommandNumber_(row.order_value);
    if (_salesCommandDateInRange_(dateText, bounds.today, bounds.today)) {
      division.orderValueToday += value;
      division.ordersToday += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.weekStart, bounds.today)) {
      division.orderValueWtd += value;
      division.ordersWtd += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.monthStart, bounds.today)) {
      division.orderValueMtd += value;
      division.ordersMtd += 1;
    }
  });
  (billingRows || []).forEach(function(row) {
    const division = get(row.division);
    const dateText = String(row.invoice_date || '').slice(0, 10);
    const value = _salesCommandNumber_(row.billed_value);
    if (_salesCommandDateInRange_(dateText, bounds.today, bounds.today)) {
      division.billingValueToday += value;
      division.billedLinesToday += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.weekStart, bounds.today)) {
      division.billingValueWtd += value;
      division.billedLinesWtd += 1;
    }
    if (_salesCommandDateInRange_(dateText, bounds.monthStart, bounds.today)) {
      division.billingValueMtd += value;
      division.billedLinesMtd += 1;
    }
  });
  (openRows || []).forEach(function(row) {
    const division = get(row.division);
    division.backlogValue += _salesCommandNumber_(row.open_order_value);
    division.openQty += _salesCommandNumber_(row.operational_open_qty);
    division.openLines += 1;
  });
  return Object.keys(map).map(function(key) {
    return map[key];
  }).filter(function(row) {
    return row.orderValueMtd || row.billingValueMtd || row.backlogValue || row.openLines;
  }).sort(function(a, b) {
    return _salesCommandNumber_(b.orderValueMtd) - _salesCommandNumber_(a.orderValueMtd) ||
      _salesCommandNumber_(b.billingValueMtd) - _salesCommandNumber_(a.billingValueMtd) ||
      a.division.localeCompare(b.division);
  });
}

function _salesCommandDaysSince_(dateText, now) {
  if (!dateText) return null;
  const dt = new Date(dateText);
  if (isNaN(dt.getTime())) return null;
  const base = now || new Date();
  return Math.max(0, Math.floor((base.getTime() - dt.getTime()) / 86400000));
}

function _salesCommandClientStatus_(row) {
  if (row.newBenchmarkFlag) return 'New Record';
  if (row.expectedMtdPct != null) {
    if (row.expectedMtdPct >= 110) return 'Ahead of Run Rate';
    if (row.expectedMtdPct >= 90) return 'On Track';
    if (row.expectedMtdPct >= 70) return 'Needs Push';
    return 'High Risk';
  }
  if (row.runningAverageDeclineFlag) return 'Below Average';
  return row.benchmarkActive ? 'On Watch' : 'No Baseline';
}

function _salesCommandBuildClientAnalytics_(clients, totals) {
  const now = new Date();
  const totalMtd = _salesCommandNumber_(totals && totals.orderValueMtd);
  const enriched = (clients || []).map(function(row) {
    const copy = Object.assign({}, row);
    const rank = _salesCommandNumber_(copy.historicalTopRank || 999999);
    const expectedPct = copy.expectedMtdPct == null ? null : _salesCommandNumber_(copy.expectedMtdPct);
    const expectedGap = _salesCommandNumber_(copy.expectedMtdGapValue);
    const avg = _salesCommandNumber_(copy.historicalAvgMonthlyValue);
    const overdue = _salesCommandNumber_(copy.overdueValue);
    const backlog = _salesCommandNumber_(copy.backlogValue);
    const concentration = totalMtd > 0 ? Math.round(_salesCommandNumber_(copy.orderValueMtd) / totalMtd * 1000) / 10 : 0;
    const daysSinceActivity = _salesCommandDaysSince_(copy.lastActivityAt, now);
    let importanceScore = 0;
    let urgencyScore = 0;
    if (rank <= 20) importanceScore = 100;
    else if (rank <= 50) importanceScore = 70;
    else if (copy.benchmarkActive) importanceScore = 45;
    if (expectedPct != null) {
      if (expectedPct < 50) urgencyScore += 40;
      else if (expectedPct < 75) urgencyScore += 30;
      else if (expectedPct < 90) urgencyScore += 15;
    }
    if (avg > 0 && expectedGap > 0) urgencyScore += Math.min(30, Math.round(expectedGap / avg * 120));
    if (overdue > 0) urgencyScore += 25;
    if (backlog > 0) urgencyScore += Math.min(15, Math.round(backlog / Math.max(avg || backlog, 1) * 12));
    if (daysSinceActivity != null && daysSinceActivity >= 14 && expectedGap > 0) urgencyScore += 10;
    const score = urgencyScore > 0
      ? Math.round(urgencyScore * (1 + Math.min(importanceScore, 100) / 200))
      : 0;
    copy.clientStatus = _salesCommandClientStatus_(copy);
    copy.clientFocusScore = score;
    copy.clientImportanceScore = importanceScore;
    copy.clientUrgencyScore = urgencyScore;
    copy.clientConcentrationPct = concentration;
    copy.daysSinceActivity = daysSinceActivity;
    if (copy.newBenchmarkFlag) {
      copy.clientFocusReason = 'Celebrate and protect service quality after new benchmark.';
    } else if (expectedPct != null && expectedPct < 70) {
      copy.clientFocusReason = 'Below expected MTD run rate; immediate sales follow-up needed.';
    } else if (overdue > 0) {
      copy.clientFocusReason = 'Overdue value is blocking delivery or billing momentum.';
    } else if (backlog > 0) {
      copy.clientFocusReason = 'Open actionable value needs closure coordination.';
    } else if (copy.projectedVsMaxPct != null && copy.projectedVsMaxPct >= -15) {
      copy.clientFocusReason = 'Projected month-end is close to a new historical max.';
    } else {
      copy.clientFocusReason = 'Monitor against historical benchmark and current month pace.';
    }
    return copy;
  });
  const historicalTop = enriched.filter(function(row) {
    return row.benchmarkActive && row.historicalTopRank && row.historicalTopRank <= 20;
  }).sort(function(a, b) {
    return _salesCommandNumber_(a.historicalTopRank) - _salesCommandNumber_(b.historicalTopRank);
  });
  const runRateWatch = enriched.filter(function(row) {
    return row.benchmarkActive && row.expectedMtdPct != null;
  }).sort(function(a, b) {
    return _salesCommandNumber_(a.expectedMtdPct) - _salesCommandNumber_(b.expectedMtdPct) ||
      _salesCommandNumber_(b.expectedMtdGapValue) - _salesCommandNumber_(a.expectedMtdGapValue);
  });
  const focusRows = enriched.filter(function(row) {
    return row.clientFocusScore > 0;
  }).sort(function(a, b) {
    return _salesCommandNumber_(b.clientFocusScore) - _salesCommandNumber_(a.clientFocusScore) ||
      _salesCommandNumber_(b.expectedMtdGapValue) - _salesCommandNumber_(a.expectedMtdGapValue) ||
      _salesCommandNumber_(b.backlogValue) - _salesCommandNumber_(a.backlogValue);
  });
  const opportunities = enriched.filter(function(row) {
    return row.newBenchmarkFlag ||
      (row.projectedVsMaxPct != null && row.projectedVsMaxPct >= -20) ||
      (_salesCommandNumber_(row.benchmarkGapValue) > 0 && _salesCommandNumber_(row.benchmarkGapValue) <= Math.max(_salesCommandNumber_(row.historicalMaxMonthlyValue) * 0.2, 1));
  }).sort(function(a, b) {
    if (a.newBenchmarkFlag !== b.newBenchmarkFlag) return a.newBenchmarkFlag ? -1 : 1;
    return _salesCommandNumber_(b.projectedVsMaxPct == null ? -999 : b.projectedVsMaxPct) -
      _salesCommandNumber_(a.projectedVsMaxPct == null ? -999 : a.projectedVsMaxPct) ||
      _salesCommandNumber_(a.benchmarkGapValue) - _salesCommandNumber_(b.benchmarkGapValue);
  });
  return {
    historicalTop: historicalTop.slice(0, 20),
    runRateWatch: runRateWatch.slice(0, 20),
    focusRows: focusRows.slice(0, 20),
    opportunities: opportunities.slice(0, 20),
    all: enriched
  };
}

function _salesCommandBuildInsights_(reps, clients, totals) {
  const insights = [];
  const targetReps = reps.filter(function(row) { return row.orderTarget > 0; });
  const biggestTargetGap = targetReps.slice().sort(function(a, b) {
    return b.orderTargetDeficit - a.orderTargetDeficit;
  })[0];
  if (biggestTargetGap && biggestTargetGap.orderTargetDeficit > 0) {
    insights.push({
      severity: biggestTargetGap.orderTargetPct != null && biggestTargetGap.orderTargetPct < 60 ? 'critical' : 'warning',
      title: 'Target recovery: ' + biggestTargetGap.salesRep,
      detail: 'Largest order-booking gap at ' + Math.round(biggestTargetGap.orderTargetPct || 0) + '% of monthly target.',
      value: biggestTargetGap.orderTargetDeficit,
      valueType: 'money'
    });
  }

  const biggestRepOverdue = reps.slice().sort(function(a, b) {
    return b.overdueValue - a.overdueValue;
  })[0];
  if (biggestRepOverdue && biggestRepOverdue.overdueValue > 0) {
    insights.push({
      severity: 'critical',
      title: 'Delivery and billing focus: ' + biggestRepOverdue.salesRep,
      detail: biggestRepOverdue.overdueLines + ' overdue order lines need closure.',
      value: biggestRepOverdue.overdueValue,
      valueType: 'money'
    });
  }

  const decliningClient = clients.filter(function(row) {
    return row.priorOrderValue > 0 && row.orderGrowthPct != null && row.orderGrowthPct < -15;
  }).sort(function(a, b) {
    return a.orderGrowthPct - b.orderGrowthPct;
  })[0];
  if (decliningClient) {
    insights.push({
      severity: 'warning',
      title: 'Client order slowdown: ' + decliningClient.clientName,
      detail: 'Current month booking is ' + Math.abs(Math.round(decliningClient.orderGrowthPct)) + '% below the prior month.',
      value: decliningClient.orderGrowthPct,
      valueType: 'percent'
    });
  }

  const topClient = clients.slice().sort(function(a, b) {
    return b.orderValueMtd - a.orderValueMtd;
  })[0];
  const concentration = totals.orderValueMtd > 0 && topClient
    ? topClient.orderValueMtd / totals.orderValueMtd * 100
    : 0;
  if (topClient && concentration >= 35) {
    insights.push({
      severity: 'info',
      title: 'Client concentration',
      detail: topClient.clientName + ' contributes ' + Math.round(concentration) + '% of current-month order booking.',
      value: concentration,
      valueType: 'percent'
    });
  }

  if (!targetReps.length) {
    insights.push({
      severity: 'info',
      title: 'Monthly targets not loaded',
      detail: 'Add salesperson targets to activate target attainment and deficit ranking.',
      value: 0,
      valueType: 'none'
    });
  }

  if (!insights.length) {
    insights.push({
      severity: 'good',
      title: 'No major exception detected',
      detail: 'Target, growth, and overdue checks are currently within the configured thresholds.',
      value: 0,
      valueType: 'none'
    });
  }
  const todayLeader = reps.slice().sort(function(a, b) {
    return b.orderValueToday - a.orderValueToday;
  })[0];
  if (todayLeader && todayLeader.orderValueToday > 0) {
    insights.push({
      severity: 'good',
      title: 'Today momentum: ' + todayLeader.salesRep,
      detail: todayLeader.ordersToday + ' orders booked today. Keep conversion follow-up active while the run rate is visible.',
      value: todayLeader.orderValueToday,
      valueType: 'money'
    });
  }

  const highBacklogClient = clients.slice().sort(function(a, b) {
    return b.backlogValue - a.backlogValue;
  })[0];
  if (highBacklogClient && highBacklogClient.backlogValue > 0) {
    insights.push({
      severity: highBacklogClient.overdueValue > 0 ? 'critical' : 'warning',
      title: 'Client backlog watch: ' + highBacklogClient.clientName,
      detail: 'Highest actionable open order value. Coordinate sales, dispatch, and billing closure.',
      value: highBacklogClient.backlogValue,
      valueType: 'money'
    });
  }

  const recordClient = clients.filter(function(row) {
    return row.newBenchmarkFlag;
  }).sort(function(a, b) {
    return b.orderValueMtd - a.orderValueMtd;
  })[0];
  if (recordClient) {
    insights.push({
      severity: 'good',
      title: 'New client benchmark: ' + recordClient.clientName,
      detail: 'This client has crossed the historical monthly max. Celebrate and protect service quality.',
      value: recordClient.orderValueMtd,
      valueType: 'money'
    });
  }

  const declineClient = clients.filter(function(row) {
    return row.runningAverageDeclineFlag || (row.expectedMtdPct != null && row.expectedMtdPct < 70);
  }).sort(function(a, b) {
    return _salesCommandNumber_(a.expectedMtdPct == null ? 999 : a.expectedMtdPct) -
      _salesCommandNumber_(b.expectedMtdPct == null ? 999 : b.expectedMtdPct) ||
      (a.vsAveragePct || 0) - (b.vsAveragePct || 0);
  })[0];
  if (declineClient) {
    const pctText = declineClient.expectedMtdPct == null
      ? Math.abs(Math.round(declineClient.vsAveragePct || 0)) + '% below historical average'
      : Math.round(declineClient.expectedMtdPct) + '% of expected MTD run rate';
    insights.push({
      severity: 'critical',
      title: 'Client run-rate risk: ' + declineClient.clientName,
      detail: 'Current month is at ' + pctText + '. Sales follow-up recommended.',
      value: declineClient.expectedMtdPct == null ? declineClient.vsAveragePct : declineClient.expectedMtdPct,
      valueType: 'percent'
    });
  }

  return insights.slice(0, 8);
}

function _salesCommandCelebrations_(reps, clients) {
  const out = [];
  (reps || []).forEach(function(row) {
    const repLabel = row.displayName || row.salesRep;
    if (row.dailyOrderTargetHit) {
      out.push({
        id: 'CELEBRATE:DAILY:' + row.salesRep,
        type: 'CELEBRATION',
        level: 'daily',
        title: repLabel + ' hit the daily target',
        detail: 'Daily score ' + row.orderValueToday + ' against target ' + row.dailyOrderTarget + '.',
        value: row.orderValueToday,
        subject: repLabel,
        salesRep: row.salesRep,
        displayName: repLabel,
        photoDataUrl: row.photoDataUrl || '',
        salesRepPhotoDataUrl: row.photoDataUrl || ''
      });
    }
    if (row.wtdOrderTargetHit) {
      out.push({
        id: 'CELEBRATE:WTD:' + row.salesRep,
        type: 'CELEBRATION',
        level: 'weekly',
        title: repLabel + ' crossed the WTD target',
        detail: 'Week score ' + row.orderValueWtd + ' against WTD target ' + row.wtdOrderTarget + '.',
        value: row.orderValueWtd,
        subject: repLabel,
        salesRep: row.salesRep,
        displayName: repLabel,
        photoDataUrl: row.photoDataUrl || '',
        salesRepPhotoDataUrl: row.photoDataUrl || ''
      });
    }
    if (row.monthlyOrderTargetHit) {
      out.push({
        id: 'CELEBRATE:MONTH:' + row.salesRep,
        type: 'CELEBRATION',
        level: 'monthly',
        title: repLabel + ' achieved the monthly target',
        detail: 'Monthly score ' + row.orderValueMtd + ' against target ' + row.orderTarget + '.',
        value: row.orderValueMtd,
        subject: repLabel,
        salesRep: row.salesRep,
        displayName: repLabel,
        photoDataUrl: row.photoDataUrl || '',
        salesRepPhotoDataUrl: row.photoDataUrl || ''
      });
    }
  });
  (clients || []).forEach(function(row) {
    if (row.newBenchmarkFlag) {
      out.push({
        id: 'CELEBRATE:CLIENT_RECORD:' + row.clientCode,
        type: 'CLIENT_RECORD',
        level: 'record',
        title: row.clientName + ' set a new monthly benchmark',
        detail: 'Current score ' + row.orderValueMtd + ' crossed historical max ' + row.historicalMaxMonthlyValue + '.',
        value: row.orderValueMtd,
        subject: row.clientName
      });
    }
  });
  return out.sort(function(a, b) { return _salesCommandNumber_(b.value) - _salesCommandNumber_(a.value); }).slice(0, 16);
}

function salesCommandGetDashboard(params, token) {
  _reportsRequireSession_(token);
  const cacheKey = _reportsCacheKey_('SALES_DASHBOARD_V9', {});
  const cached = _getCachedJson_(cacheKey);
  if (cached) return cached;

  let repRows;
  let clientRows;
  let activityRows;
  let overdueRows;
  let flowRows;
  let flowOpenRows;
  let divisionOrderRows;
  let divisionBillingRows;
  let divisionPurchaseRows;
  let brandingAssets;
  const tz = Session.getScriptTimeZone() || 'Asia/Kolkata';
  const now = new Date();
  const today = Utilities.formatDate(now, tz, 'yyyy-MM-dd');
  const monthStartDate = new Date(now.getFullYear(), now.getMonth(), 1);
  const weekStartDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  weekStartDate.setDate(weekStartDate.getDate() - ((weekStartDate.getDay() + 6) % 7));
  const monthStart = Utilities.formatDate(monthStartDate, tz, 'yyyy-MM-dd');
