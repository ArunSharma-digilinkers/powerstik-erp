      jobPriority: row.job_priority || '',
      plannedQty: Number(row.planned_qty || 0),
      producedQty: Number(row.produced_qty || 0),
      balanceQty: Number(row.balance_qty || 0),
      status: String(row.status || 'PENDING')
    };
  });
}

function _prodEnrichCorrugationFinalStageFlags_(rows) {
  const list = Array.isArray(rows) ? rows : [];
  const woIds = [...new Set(list.filter(function(row) {
    return _prodNormalizeCategoryGroup_(row.categoryGroup || '') === 'CORRUGATION';
  }).map(function(row) {
    return String(row.woId || '').trim();
  }).filter(Boolean))];
  if (!woIds.length) return list;

  const routingRows = _selectInBatches_(
    'work_order_routing',
    'id,wo_id,sequence_no,process_name,department',
    'wo_id',
    woIds,
    'sequence_no.asc'
  ) || [];
  const routingByWoId = {};
  routingRows.forEach(function(row) {
    const key = String(row.wo_id || '');
    if (!routingByWoId[key]) routingByWoId[key] = [];
    routingByWoId[key].push(row);
  });
  const finalRoutingByWoId = {};
  Object.keys(routingByWoId).forEach(function(woId) {
    const active = routingByWoId[woId].filter(function(row) {
      return !_prodIsExcludedProcess_(row.process_name || row.department || '');
    }).sort(function(a, b) {
      return Number(a.sequence_no || 0) - Number(b.sequence_no || 0);
    });
    if (active.length) finalRoutingByWoId[woId] = String(active[active.length - 1].id || '');
  });

  return list.map(function(row) {
    if (_prodNormalizeCategoryGroup_(row.categoryGroup || '') !== 'CORRUGATION') return row;
    return Object.assign({}, row, {
      isCorrugationFinalStage: String(row.routingId || '') === String(finalRoutingByWoId[String(row.woId || '')] || '')
    });
  });
}

function _prodIs2PlyMakingProcess_(row) {
  const name = String(row?.processName || row?.process_name || row?.processDisplayName || row?.department || '').trim().toUpperCase();
  return name.indexOf('2 PLY') !== -1 || name.indexOf('TWO PLY') !== -1 || name.indexOf('PLY MAKING') !== -1;
}

function _prodCorrRound3_(value) {
  const num = Number(value || 0);
  if (!isFinite(num)) return 0;
  return Math.round(num * 1000) / 1000;
}

function _prodCorrFluteFactor_(flute) {
  const key = String(flute || '').trim().toUpperCase();
  if (key === 'B') return 1.40;
  if (key === 'E') return 1.30;
  if (key === 'C') return 1.45;
  return 1.35;
}

function _prodCorrItemCodeFromText_(value) {
  const text = String(value || '').trim();
  const match = text.match(/^([A-Za-z0-9._/-]+)\s*[-|:]\s*(.+)$/);
  return match ? match[1].trim() : '';
}

function _prodCorrItemNameFromText_(value) {
  const text = String(value || '').trim();
  const match = text.match(/^([A-Za-z0-9._/-]+)\s*[-|:]\s*(.+)$/);
  return match ? match[2].trim() : text;
}

function _prodCorrIdentityKey_(value) {
  return String(value || '').replace(/\s+/g, ' ').trim().toUpperCase();
}

function _prodCorrCollectIdentityKeys_(target, value) {
  const rawKey = _prodCorrIdentityKey_(value);
  if (rawKey) target[rawKey] = true;
  const itemCode = _prodCorrIdentityKey_(_prodCorrItemCodeFromText_(value));
  const itemName = _prodCorrIdentityKey_(_prodCorrItemNameFromText_(value));
  if (itemCode) target[itemCode] = true;
  if (itemName) target[itemName] = true;
}

function _prodCorrPlyHasData_(row) {
  const ply = row || {};
  return !!(
    String(
      ply.itemDetails ||
      ply.item_name ||
      ply.itemName ||
      ply.item_code ||
      ply.itemCode ||
      ''
    ).trim() ||
    String(ply.flute || '').trim() ||
    Number(ply.gsm || 0) > 0 ||
    Number(ply.deckle || ply.deckle_mm || 0) > 0 ||
    Number(ply.cutSize || ply.cut_size || 0) > 0 ||
    Number(ply.sheets || 0) > 0 ||
    Number(ply.weightKg || ply.requiredQty || 0) > 0
  );
}

function _prodCorrPlyIdentity_(row) {
  const ply = row || {};
  const keys = {};
  [
    ply.itemDetails,
    ply.item_name,
    ply.itemName,
    ply.item_code,
    ply.itemCode
  ].forEach(function(value) {
    _prodCorrCollectIdentityKeys_(keys, value);
  });
  return Object.keys(keys);
}

function _prodCorrPaperIdentitySet_(snapshot) {
  const papers = Array.isArray(snapshot?.papers) ? snapshot.papers : [];
  const out = {};
  papers.forEach(function(paper) {
    [
      paper?.itemLabel,
      paper?.stock,
      paper?.parentName,
      paper?.item_name,
      paper?.itemName,
      paper?.item_code,
      paper?.itemCode
    ].forEach(function(value) {
      _prodCorrCollectIdentityKeys_(out, value);
    });
  });
  return out;
}

function _invReceiptCommercialControl_(payload, liveLine) {
  const baseLine = liveLine || {};
  const policy = _purchaseNormalizeRatePolicy_(baseLine.ratePolicy || baseLine.rate_policy);
  const governedTaxPct = Number(baseLine.taxPct || baseLine.tax_pct || 0);
  const taxMismatch = policy === 'RATE_CONTROLLED' &&
    Math.abs(Number(payload.taxPct || 0) - governedTaxPct) > 0.0001;
  const ceilingRate = _purchaseEffectiveGRNCeiling_(baseLine);
  return {
    policy: policy,
    ceilingRate: ceilingRate,
    governedTaxPct: governedTaxPct,
    taxMismatch: taxMismatch,
    overrideRequired: policy === 'RATE_CONTROLLED' &&
      _purchaseRateExceedsCeiling_(Number(payload.rate || 0), ceilingRate)
  };
}

function _invReceiptCommercialMismatch_(payload, liveLine) {
  const control = _invReceiptCommercialControl_(payload, liveLine);
  return control.taxMismatch || control.overrideRequired;
}

function _invAssertReceiptHeaderMetadata_(payload) {
  const invoiceNo = String(payload.invoiceNo || '').trim();
  const invoiceDate = String(payload.invoiceDate || '').trim();
  const challanNo = String(payload.challanNo || '').trim();
  const challanDate = String(payload.challanDate || '').trim();
  if (!invoiceNo) throw new Error('Invoice No required');
  if (!invoiceDate) throw new Error('Invoice Date required');
  if ((challanNo && !challanDate) || (!challanNo && challanDate)) {
    throw new Error('Challan No and Challan Date must both be entered');
  }
}

function _prodExtractBoardPlyCountFromText_(value) {
  const text = String(value || '').trim().toUpperCase();
  if (!text) return 0;
  const match = text.match(/(?:^|[^0-9])([3579])\s*PLY\b/);
  return match ? Number(match[1] || 0) : 0;
}

function _prodExtractBoardPlyCountFromSnapshot_(snapshot, extraTexts) {
  const snap = snapshot || {};
  const jobDetails = _safeJsonObject_(snap.jobDetails);
  const explicitBoardPlyCount = Number(jobDetails.totalBoardPlyCount || 0);
  if (explicitBoardPlyCount > 0) return explicitBoardPlyCount;

  const explicitSetCount = Number(jobDetails.corrugationSetCount || 0);
  if (explicitSetCount > 0) {
    return Math.max((Math.round(explicitSetCount) * 2) + 1, 0);
  }

  const jobs = Array.isArray(snap.jobs) ? snap.jobs : [];
  const texts = [];
  jobs.forEach(function(job) {
    [
      job?.productName,
      job?.product_name,
      job?.itemName,
      job?.item_name,
      job?.description,
      job?.itemLabel
    ].forEach(function(value) {
      if (String(value || '').trim()) texts.push(String(value));
    });
  });
  (Array.isArray(extraTexts) ? extraTexts : [extraTexts]).forEach(function(value) {
    if (String(value || '').trim()) texts.push(String(value));
  });

  const jobNamePlyCount = texts.reduce(function(max, value) {
    const count = _prodExtractBoardPlyCountFromText_(value);
    return count > max ? count : max;
  }, 0);
  if (jobNamePlyCount > 0) return jobNamePlyCount;

  return 0;
}

function _prodCorr2PlySetCountFromSnapshot_(snapshot, corrRowCount, extraTexts) {
  const snap = snapshot || {};
  const jobDetails = _safeJsonObject_(snap.jobDetails);
  const explicitBoardPlyCount = _prodExtractBoardPlyCountFromSnapshot_(snap, extraTexts);
  if (explicitBoardPlyCount > 0) {
    return Math.max(Math.ceil(explicitBoardPlyCount / 2) - 1, 0);
  }
  const corrRows = (Array.isArray(snap.corrugation) ? snap.corrugation : []).filter(_prodCorrPlyHasData_);
  const explicitSetCount = Number(jobDetails.corrugationSetCount || 0);
  if (explicitSetCount > 0) {
    return Math.max(Math.round(explicitSetCount), 0);
  }
  const flutedCount = corrRows.filter(function(row) {
    return !!String(row?.flute || '').trim() || row?.hasFlute === true;
  }).length;
  if (flutedCount > 0) {
    // Each 2-ply set has exactly one flute row. Prefer this as the next
    // fallback because it is usually more stable than raw corrugation row count.
    return flutedCount;
  }
  const rowCount = Number(corrRowCount || 0);
  if (rowCount > 0) {
    return Math.max(Math.floor(rowCount / 2), 0);
  }
  return 0;
}

function _prodCorrGroupKey_(parts) {
  return [
    parts.linerItemCode || '',
    parts.linerItemName || '',
    Number(parts.linerGsm || 0).toFixed(2),
    parts.flutingItemCode || '',
    parts.flutingItemName || '',
    Number(parts.flutingGsm || 0).toFixed(2),
    String(parts.flute || '').trim().toUpperCase(),
    Number(parts.deckleMm || 0).toFixed(2),
    Number(parts.cutSizeMm || 0).toFixed(2)
  ].join('|').toUpperCase();
}

function _prodCorrSheetPlanFromSnapshot_(snapshot) {
  const snap = snapshot || {};
  const papers = Array.isArray(snap.papers) ? snap.papers : [];
  const fromPapers = papers.reduce(function(max, paper) {
    const qty = Number(paper?.sheetsWithWaste ?? paper?.requiredQty ?? paper?.coreSheets ?? paper?.sheets ?? 0);
    return qty > max ? qty : max;
  }, 0);
  if (fromPapers > 0) return fromPapers;

  const jobs = Array.isArray(snap.jobs) ? snap.jobs : [];
  const waste = Number(snap?.wastage?.processSheets || 0);
  const totalQty = jobs.reduce(function(sum, job) {
    return sum + Number(job?.qty || 0);
  }, 0);
  const groupUps = Number(
    snap?.jobDetails?.ups ||
    snap?.jobDetails?.groupUPS ||
    snap?.jobDetails?.groupUps ||
    snap?.jobDetails?.totalUps ||
    0
  ) || jobs.reduce(function(sum, job) {
    const ups = Number(job?.ups || job?.groupUps || job?.group_ups || 0);
    return sum + (ups > 0 ? ups : 0);
  }, 0);
  if (totalQty > 0 && groupUps > 0) return Math.ceil(totalQty / groupUps) + waste;

  const jobSheetValues = jobs.map(function(job) {
    return Number(job?.sheetsWithWaste || job?.requiredQty || job?.coreSheets || job?.sheets || 0);
  }).filter(function(qty) {
    return qty > 0;
  });
  if (jobSheetValues.length) {
    return jobSheetValues.reduce(function(max, qty) {
      return qty > max ? qty : max;
    }, 0);
  }

  const corrRows = Array.isArray(snap.corrugation) ? snap.corrugation : [];
  const corrSheetValues = corrRows.map(function(row) {
    return Number(row?.sheets || 0);
  }).filter(function(qty) {
    return qty > 0;
  });
  if (corrSheetValues.length) {
    return corrSheetValues.reduce(function(min, qty) {
      return min === 0 || qty < min ? qty : min;
    }, 0);
  }

  return 0;
}

function _prodBuildCorr2PlyGroupsFromSnapshot_(snapshot, options) {
  const opts = options || {};
  const rawPlies = (Array.isArray(snapshot?.corrugation) ? snapshot.corrugation : []).filter(_prodCorrPlyHasData_).slice().sort(function(a, b) {
    return Number(a?.plyNo || 0) - Number(b?.plyNo || 0);
  });
  if (rawPlies.length < 2) return [];
  const expectedSetCount = _prodCorr2PlySetCountFromSnapshot_(snapshot, rawPlies.length, [
    opts.productText,
    opts.productName,
    opts.productNames
  ]);
  if (!(expectedSetCount > 0)) return [];
  const hasExplicitFluteRows = rawPlies.some(function(ply) {
    return !!String(ply?.flute || '').trim() || ply?.hasFlute === true;
  });
  let allPlies = rawPlies;
  if (rawPlies.length % 2 === 1) {
    if (!hasExplicitFluteRows) {
      const paperIdentitySet = _prodCorrPaperIdentitySet_(snapshot);
      const duplicateTopIndex = rawPlies.findIndex(function(ply) {
        const identities = _prodCorrPlyIdentity_(ply);
        return identities.some(function(identity) {
          return paperIdentitySet[identity] === true;
        });
      });
      if (duplicateTopIndex >= 0 && rawPlies.length > 2) {
        // Legacy or BOM-derived snapshots sometimes carry the top printed/plain
        // sheet inside corrugation lines. Remove one such row before fallback
        // pairing so a 5-ply board resolves to 4 corrugation rows -> 2 sets.
        allPlies = rawPlies.filter(function(_, index) {
          return index !== duplicateTopIndex;
        });
      }
    }
    // Current WO design stores only corrugation layers in this array, so even
    // row counts are the source of truth. Odd counts are treated as legacy data
    // and trimmed by dropping the top printed/plain sheet fallback row.
    if (allPlies.length % 2 === 1) {
      allPlies = allPlies.slice(1);
    }
  }
  const plies = allPlies;
  if (plies.length < 2) return [];

  // Prefer the base planned quantity already resolved by the fast production
  // view. This keeps live stage rows aligned even when older snapshots have
  // noisy paper/corrugation structures.
  const defaultSheets = _prodCorrRound3_(
    Number(opts.basePlanQty || 0) > 0
      ? Number(opts.basePlanQty || 0)
      : _prodCorrSheetPlanFromSnapshot_(snapshot)
  );
  const useFixedSheetPlan = defaultSheets > 0;
  const groupsByKey = {};
  const maxSetCount = Math.min(expectedSetCount, Math.floor(plies.length / 2));
  const setSheetPlan = defaultSheets;

  const usedLinerIndexes = {};
  const flutedIndexes = plies.map(function(ply, index) {
    return (!!String(ply?.flute || '').trim() || ply?.hasFlute === true) ? index : -1;
  }).filter(function(index) { return index >= 0; });

  const setPairs = flutedIndexes.slice(0, maxSetCount).map(function(fluteIndex, pairIndex) {
    let linerIndex = -1;
    for (let next = fluteIndex + 1; next < plies.length; next += 1) {
      const candidate = plies[next] || {};
      if (usedLinerIndexes[next]) continue;
      if (String(candidate.flute || '').trim() || candidate.hasFlute === true) continue;
      linerIndex = next;
      break;
    }
    if (linerIndex < 0) {
      for (let prev = fluteIndex - 1; prev >= 0; prev -= 1) {
        const candidate = plies[prev] || {};
        if (usedLinerIndexes[prev]) continue;
        if (String(candidate.flute || '').trim() || candidate.hasFlute === true) continue;
        linerIndex = prev;
        break;
      }
    }
    if (linerIndex >= 0) usedLinerIndexes[linerIndex] = true;
    return {
      setNo: pairIndex + 1,
      fluting: plies[fluteIndex] || {},
      liner: linerIndex >= 0 ? (plies[linerIndex] || {}) : {}
    };
  });

  const fallbackPairs = (function() {
    const fallback = [];
    for (let i = 0; i < plies.length && fallback.length < maxSetCount; i += 2) {
      fallback.push({
        setNo: Math.floor(i / 2) + 1,
        fluting: plies[i] || {},
        liner: plies[i + 1] || {}
      });
    }
    return fallback;
  })();
  const effectivePairs = setPairs.length === maxSetCount ? setPairs : fallbackPairs;

  effectivePairs.forEach(function(pair) {
    const fluting = pair.fluting || {};
    const liner = pair.liner || {};
    const setNo = pair.setNo;
    const fallbackPairSheets = Math.max(
      Number(fluting.sheets || 0),
      Number(liner.sheets || 0)
    );
    const pairPlanQty = useFixedSheetPlan ? Number(setSheetPlan || 0) : Number(fallbackPairSheets || 0);
    const parts = {
      setNo: setNo,
      flute: fluting.flute || '',
      linerItemCode: _prodCorrItemCodeFromText_(liner.itemCode || liner.item_code || liner.itemDetails || liner.item_name || ''),
      linerItemName: _prodCorrItemNameFromText_(liner.itemDetails || liner.item_name || liner.itemName || ''),
      linerGsm: Number(liner.gsm || 0),
      flutingItemCode: _prodCorrItemCodeFromText_(fluting.itemCode || fluting.item_code || fluting.itemDetails || fluting.item_name || ''),
      flutingItemName: _prodCorrItemNameFromText_(fluting.itemDetails || fluting.item_name || fluting.itemName || ''),
      flutingGsm: Number(fluting.gsm || 0),
      deckleMm: Number(fluting.deckle || liner.deckle || 0),
      cutSizeMm: Number(fluting.cutSize || fluting.cut_size || liner.cutSize || liner.cut_size || 0),
      // 2-ply production output is board sheets per set. Corrugation rows
      // carry the job-card sheet count; requiredQty on these rows is KG.
      planQty: pairPlanQty
    };
    const key = _prodCorrGroupKey_(parts);
    if (!groupsByKey[key]) {
      groupsByKey[key] = Object.assign({
        groupKey: key,
        setNumbers: [],
        setCount: 0,
        planQty: 0
      }, parts);
    }
    groupsByKey[key].setNumbers.push(String(setNo));
    groupsByKey[key].setCount += 1;
    if (!useFixedSheetPlan) {
      groupsByKey[key].planQty += Number(parts.planQty || 0);
    }
  });
  return Object.keys(groupsByKey).map(function(key) {
    const group = groupsByKey[key];
    if (useFixedSheetPlan) {
      group.planQty = _prodCorrRound3_(setSheetPlan * Number(group.setCount || 0));
    }
    group.setNumbersText = group.setNumbers.join(', ');
    group.description = '2 Ply Set ' + group.setNumbersText + ' | ' +
      (group.flutingItemName || 'Fluting') + ' ' + (group.flutingGsm || '') + ' GSM' +
      (group.flute ? ' ' + group.flute + ' flute' : '') + ' + ' +
      (group.linerItemName || 'Liner') + ' ' + (group.linerGsm || '') + ' GSM';
    return group;
  });
}

function _prodGetCorr2PlyDetailTotals_(routingIds) {
