    monthlyOrderTargetHit: row.monthly_order_target_hit === true || String(row.monthly_order_target_hit || '').toLowerCase() === 'true',
    orderGrowthPct: row.order_growth_pct == null ? null : _salesCommandNumber_(row.order_growth_pct),
