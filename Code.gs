    dimensionUnit: dimensionUnit,
    lengthUnit: String(src.length_unit || src.lengthUnit || '').trim(),
    widthUnit: String(src.width_unit || src.widthUnit || '').trim(),
    heightUnit: String(src.height_unit || src.heightUnit || '').trim(),
