function planningUpdateBilledLineStatus(payload, token) {
  const user = _planningClosureEditUser_(token);
  const p = payload || {};
  const soLineId = String(p.soLineId || '').trim();
  const requestedStatus = String(p.targetStatus || '').trim().toUpperCase();
  if (!soLineId) throw new Error('Sales order line is required');
  if (['CLOSED', 'PARTIAL_DISPATCHED', 'SHORT_CLOSED'].indexOf(requestedStatus) === -1) {
    throw new Error('Invalid billed closure status');
  }

  let line;
  try {
    line = (supabaseSelect_('sales_order_lines', {
      select: 'id,so_id,line_no,qty,status,closed_at,closed_by',
      filters: { id: 'eq.' + soLineId },
      limit: 1
    }) || [])[0];
  } catch (err) {
    if (_planningLifecycleColumnsMissing_(err)) {
      throw new Error('Run sales_order_line_status_schema.sql before using the billed closure planning module.');
    }
    throw err;
  }
  if (!line || !line.id) throw new Error('Sales order line not found');

  const soHeader = line.so_id ? (supabaseSelect_('sales_orders', {
    select: 'so_number',
    filters: { id: 'eq.' + line.so_id },
    limit: 1
  }) || [])[0] : null;
  const usage = _billingGetInvoiceUsageByLineIds_([soLineId])[soLineId] || {};
  const billedQty = _billingRound2_(usage.billedQty);
  const dispatchedQty = billedQty;
  const orderQty = _billingRound2_(line.qty);
  const stamp = new Date().toISOString();
  const actor = String((user && (user.displayName || user.userId)) || 'system').trim();

  let effectiveStatus = requestedStatus;
  let update;
  if (orderQty > 0 && billedQty >= orderQty) {
    effectiveStatus = 'CLOSED';
    update = {
      status: 'CLOSED',
      closed_at: line.closed_at || stamp,
      closed_by: line.closed_by || 'System - fully billed',
      status_updated_at: stamp
    };
  } else if (requestedStatus === 'SHORT_CLOSED') {
    update = {
      status: 'CLOSED',
      closed_at: stamp,
      closed_by: 'Manual Short Close - ' + actor,
      status_updated_at: stamp
    };
  } else if (requestedStatus === 'CLOSED') {
    update = {
      status: 'CLOSED',
      closed_at: stamp,
      closed_by: 'Manual Close - ' + actor,
      status_updated_at: stamp
    };
  } else {
    update = {
      status: 'PARTIAL_DISPATCHED',
      closed_at: null,
      closed_by: null,
      status_updated_at: stamp
    };
  }

  try {
    supabaseUpdateMinimal_('sales_order_lines', { id: 'eq.' + soLineId }, update);
  } catch (err) {
    if (_planningLifecycleColumnsMissing_(err)) {
      throw new Error('Run sales_order_line_status_schema.sql before using the billed closure planning module.');
    }
    throw err;
  }

  let persistedLine = line;
  try {
    persistedLine = (supabaseSelect_('sales_order_lines', {
      select: 'id,so_id,line_no,qty,status,closed_at,closed_by,status_updated_at',
      filters: { id: 'eq.' + soLineId },
      limit: 1
    }) || [])[0] || line;
  } catch (err) {
    if (_planningLifecycleColumnsMissing_(err)) {
      throw new Error('Run sales_order_line_status_schema.sql before using the billed closure planning module.');
    }
    throw err;
  }

  const persistedPreview = {
    rawLineStatus: String((persistedLine && persistedLine.status) || update.status || line.status || 'OPEN').trim().toUpperCase() || 'OPEN',
    closedBy: (persistedLine && persistedLine.closed_by) || update.closed_by || '',
    dispatchedQty: dispatchedQty,
    orderQty: orderQty,
    autoClosedByDispatch: orderQty > 0 && billedQty >= orderQty
  };
  const closureStatus = _planningDisplayClosureStatus_(persistedPreview);
  if (requestedStatus === 'SHORT_CLOSED' && closureStatus !== 'SHORT_CLOSED' && !persistedPreview.autoClosedByDispatch) {
    throw new Error('Short close was not saved on this sales order line. Please refresh and try again; if it repeats, check sales_order_lines.status/closed_by for this line.');
  }
  const closureReason = (function() {
    const preview = Object.assign({}, persistedPreview);
    preview.closureStatus = closureStatus;
    return _planningClosureReason_(preview);
  })();

  return {
    ok: true,
    soLineId: soLineId,
    soNumber: soHeader && soHeader.so_number ? soHeader.so_number : '',
    lineNo: (persistedLine && persistedLine.line_no) || line.line_no || '',
    status: closureStatus || effectiveStatus,
    dispatchedQty: dispatchedQty,
    billedQty: billedQty,
    dispatchBalanceQty: Math.max(orderQty - billedQty, 0),
    orderQty: orderQty,
    rawLineStatus: persistedPreview.rawLineStatus,
    closedAt: (persistedLine && persistedLine.closed_at) || update.closed_at || '',
    closedBy: persistedPreview.closedBy || '',
    statusUpdatedAt: (persistedLine && persistedLine.status_updated_at) || update.status_updated_at || stamp,
    autoClosedByDispatch: orderQty > 0 && billedQty >= orderQty,
    closureStatus: closureStatus,
    closureReason: closureReason
  };
}

