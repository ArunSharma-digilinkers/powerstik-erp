      paymentTerms: row.payment_terms || '',
      freightTerms: row.freight_terms || '',
      remarks: row.remarks || ''
    };
  }).filter(function(row) {
    return _reportsDatePasses_(row.grnDate, dateFilters) &&
      _reportsTextPasses_(row, filters, [
        'grnNo',
        'receiptType',
        'department',
        'poNo',
        'prNo',
        'vendorName',
        'supplierInvoiceNo',
        'challanNo',
        'itemCode',
        'itemName',
        'itemCategory',
